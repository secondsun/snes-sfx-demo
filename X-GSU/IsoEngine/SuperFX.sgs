.include "libSFX.i"
.include "../common/stack.i"
.include "../common/function.i"

.segment "GSUCODE"
GSU_Code:
.export GSU_Code

init_stack

resetFrameBuffer:
move r3, r0       ; preserve the execution index passed from the CPU
iwt r0,#0
cmode
iwt r1, #$4000
iwt r12, #$1400
cache
move r13, r15
  stw(r1)
  inc r1
  loop
  nop
  inc r1
  

init_gsu_main:
	;set plot register options
	; bit 0 = 0 Transparency On
	; bit 1 = 0 dither off
	; bit 2 = 0 upper 4 bit color off
	; bit 3 = 1 sprite mode on
	iwt r0, #$8
	cmode
	iwt r0, #8
	color

	iwt r0, #0
	cmp r3
	bne right_half
	nop
	iwt r4, #120      ; left half: first 8 pixels of a 16-pixel centered square
	bra x_ready
	nop
right_half:
	iwt r4, #0; right half: next 8 pixels of the same centered square
x_ready:
	iwt r2, #64; start Y for the centered square
	iwt r13, #draw_square_row
	iwt r12, #16; draw 16 rows

	draw_square_row:
	move r1, r4
	plot
	plot
	plot
	plot
	plot
	plot
	plot
	plot

	
	inc r2            ; move to the next row
	loop
	nop

draw_polygon:
	
	;xPoints
	move r3, r10
	ibt r0, #$10
	gsu_stack_push 
	ibt r0, #$30
	gsu_stack_push 
	ibt r0, #$20
	gsu_stack_push 

	;yPoints
	move r4, r10
	ibt r0, #$20
	gsu_stack_push 
	ibt r0, #$60
	gsu_stack_push 
	ibt r0, #$40
	gsu_stack_push 

	;color
	iwt r5, #$A

	call draw_triangle

finish:

	shutdown:
	rpix
	rpix
	stop
	nop
	nop
	nop

.align 2
xPoints:
.dword $10, $20, $30
yPoints:
.dword $10, $20, $30

.include "./triangle/drawTriangle.i"


.segment "GSURAM"
