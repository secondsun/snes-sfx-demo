.include "libSFX.i"
.include "../common/stack.i"
.include "../common/function.i"
.include "./macros/geometry.i"
.segment "GSUCODE"
.include "../gsu_maths/gsu_recip.i"
GSU_Code:
.export GSU_Code

init_stack

resetFrameBuffer:
iwt r0,#0
cmode
iwt r1, #$4000
iwt r12, #$1400
cache
move r13, r15
  stw(r1)
  inc r1
  loop
  inc r1
  nop
  
  

init_gsu_main:
	;set plot register options
	; bit 0 = 0 Transparency On
	; bit 1 = 0 dither off
	; bit 2 = 0 upper 4 bit color off
	; bit 3 = 1 sprite mode on
	iwt r0, #$8
	cmode

    move r3, r10

    rom_to_stack #cube_model,3, 216

    ibt r5, #12
    call draw_triangle


finish:

	shutdown:
	rpix
	rpix
	stop
	nop
	nop
	nop

.align 2
cube_model:
 cube $2000,$2000,$2000, $4000


.include "./triangle/drawTriangle.i"

