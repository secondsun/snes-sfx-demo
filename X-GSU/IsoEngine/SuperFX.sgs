.debuginfo + 
.include "libSFX.i"
.include "../common/stack.i"
.include "../common/function.i"
.include "./macros/geometry.i"
.include "./constants.i"
.segment "GSUCODE"
.include "../gsu_maths/gsu_recip.i"
.include "../gsu_maths/gsu_vector.i"
GSU_Code:
.export GSU_Code

init_stack
register fb_ptr, model_ptr, mat_ptr, tri_ptr, tri_color, free_size

resetFrameBuffer:
iwt r0, #0
cmode
iwt fb_ptr, #$4000
iwt r12, #$1400
cache
move r13, r15
  stw (fb_ptr)
  inc fb_ptr
  loop
  inc fb_ptr
  nop
  
  

init_gsu_main:
	;set plot register options
	; bit 0 = 0 Transparency On
	; bit 1 = 0 dither off
	; bit 2 = 0 upper 4 bit color off
	; bit 3 = 1 sprite mode on
	iwt r0, #$8
	cmode

    move model_ptr, r10
    rom_to_stack #cube_model, 3, 216

	move mat_ptr, r10
    rom_to_stack #transformation_matrix, 3, 32

	call vector3_transform model_ptr, mat_ptr


    iwt tri_color, #cube_model
    call draw_triangle model_ptr, tri_color

	iwt free_size, #216
	gsu_stack_free_bytes free_size

finish:

	shutdown:
	rpix
	rpix
	stop
	nop
	nop
	nop

.align 2
cube_model:
 cube $e000, $e000, $e000, $4000
transformation_matrix:
.word $0100, $0000, $0000, $4000
.word $0000, $0100, $0000, $4000
.word $0000, $0000, $0100, $0000
.word $0000, $0000, $0000, $0100


.include "./triangle/drawTriangle.i"

.segment "GSURAM"
POLYGON_OUT:
.res .sizeof(vector3)

