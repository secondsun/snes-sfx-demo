.include "libSFX.i"


.segment "GSUCODE"
GSU_Code:
.export GSU_Code

resetFrameBuffer:
move r3, r0       ; preserve the execution index passed from the CPU
iwt r0,#0
cmode
iwt r1, #$4000
iwt r12, #$1400
cache
move r13, r15
  stw(r1)
  inc r1
  loop
  nop
  inc r1
  

init_gsu_main:
	
	iwt r0, #0
	cmode
	iwt r0, #8
	color

	iwt r0, #0
	cmp r3
	bne right_half
	nop
	iwt r4, #120      ; left half: first 8 pixels of a 16-pixel centered square
	bra x_ready
	nop
right_half:
	iwt r4, #0; right half: next 8 pixels of the same centered square
x_ready:
	iwt r2, #64; start Y for the centered square
	iwt r13, #draw_square_row
	iwt r12, #16; draw 16 rows

	draw_square_row:
	move r1, r4
	plot
	plot
	plot
	plot
	plot
	plot
	plot
	plot

	
	inc r2            ; move to the next row
	loop
	nop

finish:

	shutdown:
	rpix
	rpix
	stop
	nop
	nop
	nop


.segment "GSURAM"
