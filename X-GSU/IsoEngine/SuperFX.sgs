.include "libSFX.i"
.include "../common/stack.i"
.include "../common/function.i"


.segment "GSUCODE"
.include "../gsu_maths/gsu_recip.i"
GSU_Code:
.export GSU_Code

init_stack

resetFrameBuffer:
move r3, r0       ; preserve the execution index passed from the CPU
iwt r0,#0
cmode
iwt r1, #$4000
iwt r12, #$1440
cache
move r13, r15
  stw(r1)
  inc r1
  loop
  inc r1
  nop
  
  

init_gsu_main:
	;set plot register options
	; bit 0 = 0 Transparency On
	; bit 1 = 0 dither off
	; bit 2 = 0 upper 4 bit color off
	; bit 3 = 1 sprite mode on
	iwt r0, #$8
	cmode
	iwt r0, #8
	color

	iwt r0, #0
	cmp r3
	bne right_half
	nop
;leftHalf
	iwt r4, #0      ; left half: first 8 pixels of a 16-pixel centered square
	sm (FRAME_BUFFER_X_MIN), r4
	iwt r0, #127
	sm (FRAME_BUFFER_X_MAX), r0
	bra draw_polygons
	nop

right_half:
	iwt r4, #128; right half: next 8 pixels of the same centered square
	sm (FRAME_BUFFER_X_MIN), r4
	iwt r0, #255
	sm (FRAME_BUFFER_X_MAX), r0

draw_polygons:
	
	;xPoints
	move r3, r10
	iwt r0, #0
	gsu_stack_push 
	iwt r0, #127
	gsu_stack_push 
	iwt r0, #0
	gsu_stack_push 

	;yPoints
	move r4, r10
	iwt r0, #10
	gsu_stack_push 
	iwt r0, #20
	gsu_stack_push 
	iwt r0, #60
	gsu_stack_push 

	;color
	iwt r5, #$4

	call draw_triangle

finish:

	shutdown:
	rpix
	rpix
	stop
	nop
	nop
	nop

.align 2
xPoints:
.dword $10, $20, $30
yPoints:
.dword $10, $20, $30

.include "./triangle/drawTriangle.i"

