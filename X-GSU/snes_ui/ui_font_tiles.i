; ==============================================================================
; ui_font_tiles.i - 2bpp 8x8 ASCII Font, 9-Slice RPG Window Tiles & Palettes
;
; Part of `snes_ui` (Epic #30 / Issue #36).
; Provides:
;   - 96 2bpp 8x8 tiles (1,536 bytes) for SNES Mode 1 BG3 (BG3_PRIO_HIGH):
;       $00      : Transparent blank (exposes BG1 3D viewport)
;       $01      : Solid window interior fill (color 1)
;       $02..$09 : 9-slice RPG window border tiles (TL, T, TR, L, R, BL, B, BR)
;       $0A..$0F : UI icons (Cursor arrow, Heart, Sword, Shield, Boots/MP, Star)
;       $10..$1F : Dividers & progress bar tiles (H-line, V-line, bar fill)
;       $20..$5F : Direct-mapped ASCII font (' ' through '_', uppercase/digits/punct)
;   - 4 distinct 2bpp palettes (32 bytes -> CGRAM indices 16..31 = BG3 Pal 4..7):
;       UI_PAL_ACTIVE   (4): Focused window border & bright white text
;       UI_PAL_UNFOCUS  (5): Unfocused / dimmed window border & muted text
;       UI_PAL_DISABLED (6): Disabled / greyed-out menu option text
;       UI_PAL_ALERT    (7): Highlighted / alert / selected text
;
; NOTE: BG3 Palettes 4..7 occupy CGRAM 16..31, completely avoiding collision
; with BG1 Palette 0 (CGRAM 0..15) used by the SuperFX 3D terrain renderer.
; ==============================================================================

.ifndef __SNES_UI_FONT_TILES__
__SNES_UI_FONT_TILES__ = 1

; ------------------------------------------------------------------------------
; Default VRAM / CGRAM Placement (overridable before .include)
; ------------------------------------------------------------------------------
.ifndef VRAM_BG3_TILES
VRAM_BG3_TILES          = $E000         ; 2 KB ($E000..$E7FF), $2000-aligned for BG34NBA
.endif

.ifndef UI_BG3_CGRAM_BASE
UI_BG3_CGRAM_BASE       = 16            ; CGRAM 16..31 = BG3 Palettes 4..7
.endif

; ------------------------------------------------------------------------------
; BG3 Palette Indices (0..7)
; ------------------------------------------------------------------------------
UI_PAL_ACTIVE           = 4             ; CGRAM 16..19: Focused border & white text
UI_PAL_UNFOCUS          = 5             ; CGRAM 20..23: Unfocused / dim border & text
UI_PAL_DISABLED         = 6             ; CGRAM 24..27: Disabled / greyed menu text
UI_PAL_ALERT            = 7             ; CGRAM 28..31: Alert / highlighted / cursor text

; ------------------------------------------------------------------------------
; Tile Index Constants
; ------------------------------------------------------------------------------
UI_TILE_TRANSPARENT     = $00           ; All color 0 (transparent over BG1)
UI_TILE_SOLID           = $01           ; All color 1 (opaque window background)

; 9-Slice RPG Window Border Tiles
UI_TILE_BOX_TL          = $02           ; Top-left corner
UI_TILE_BOX_T           = $03           ; Top horizontal edge
UI_TILE_BOX_TR          = $04           ; Top-right corner
UI_TILE_BOX_L           = $05           ; Left vertical edge
UI_TILE_BOX_R           = $06           ; Right vertical edge
UI_TILE_BOX_BL          = $07           ; Bottom-left corner
UI_TILE_BOX_B           = $08           ; Bottom horizontal edge
UI_TILE_BOX_BR          = $09           ; Bottom-right corner

; UI Icons
UI_TILE_CURSOR          = $0A           ; Right-pointing cursor arrow
UI_TILE_HEART           = $0B           ; Heart / HP icon
UI_TILE_SWORD           = $0C           ; Sword / ATK icon
UI_TILE_SHIELD          = $0D           ; Shield / DEF icon
UI_TILE_BOOTS           = $0E           ; Step / MP icon
UI_TILE_STAR            = $0F           ; Star / Alert / Secret icon

; Dividers & Bars
UI_TILE_HLINE           = $10           ; Horizontal interior divider
UI_TILE_VLINE           = $11           ; Vertical interior divider
UI_TILE_BAR_EMPTY       = $12           ; Empty meter segment
UI_TILE_BAR_HALF        = $13           ; Half meter segment
UI_TILE_BAR_FULL        = $14           ; Full meter segment

UI_TILE_ASCII_BASE      = $20           ; Direct ASCII $20..$5F

; ------------------------------------------------------------------------------
; Convenience Macro: Upload BG3 Font Tiles & 4 Palettes During Boot
; Must be called while forced blank (or VBlank) and ROM bus is owned by 65816.
; ------------------------------------------------------------------------------
.macro UI_LOAD_FONT_AND_PALETTES
        VRAM_memcpy  VRAM_BG3_TILES, ui_font_tiles, (ui_font_tiles_end - ui_font_tiles)
        CGRAM_memcpy UI_BG3_CGRAM_BASE, ui_bg3_palettes, (ui_bg3_palettes_end - ui_bg3_palettes)
.endmac

; ------------------------------------------------------------------------------
; Internal 2bpp Tile Authoring Helpers
; ------------------------------------------------------------------------------
; Encodes an 8x8 ASCII glyph: 1-bits -> color 3 (text), 0-bits -> color 1 (panel fill).
.macro _ui_glyph r0, r1, r2, r3, r4, r5, r6, r7
        .byte $FF, r0, $FF, r1, $FF, r2, $FF, r3
        .byte $FF, r4, $FF, r5, $FF, r6, $FF, r7
.endmac

; ------------------------------------------------------------------------------
; RODATA: 2bpp Font, 9-Slice Borders, Icons & 4 Palettes
; ------------------------------------------------------------------------------
.segment "RODATA"

ui_bg3_palettes:
        ; Pal 4 (CGRAM 16..19): Active / Focused (navy fill, gold border, white text)
        .word $0000, $2882, $2B5E, $7FFF
        ; Pal 5 (CGRAM 20..23): Unfocused / Dim (dark slate fill, steel border, light grey text)
        .word $0000, $1C62, $4631, $5AD6
        ; Pal 6 (CGRAM 24..27): Disabled / Grey (navy fill, dim grey, medium grey text)
        .word $0000, $2882, $294A, $3DEF
        ; Pal 7 (CGRAM 28..31): Alert / Highlight (navy fill, coral-orange accent, bright yellow)
        .word $0000, $2882, $11DF, $1BFF
ui_bg3_palettes_end:

ui_font_tiles:
; $00: UI_TILE_TRANSPARENT (all color 0)
        .byte $00,$00, $00,$00, $00,$00, $00,$00, $00,$00, $00,$00, $00,$00, $00,$00

; $01: UI_TILE_SOLID (all color 1 = panel fill)
        .byte $FF,$00, $FF,$00, $FF,$00, $FF,$00, $FF,$00, $FF,$00, $FF,$00, $FF,$00

; $02: UI_TILE_BOX_TL (rounded bevel top-left corner; outer pixels color 0, bevel color 3/2, fill color 1)
        .byte %00000000, %00000000
        .byte %00111111, %00111111
        .byte %01100000, %01111111
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000

; $03: UI_TILE_BOX_T (top horizontal border)
        .byte %00000000, %00000000
        .byte %11111111, %11111111
        .byte %00000000, %11111111
        .byte %11111111, %00000000
        .byte %11111111, %00000000
        .byte %11111111, %00000000
        .byte %11111111, %00000000
        .byte %11111111, %00000000

; $04: UI_TILE_BOX_TR (rounded bevel top-right corner)
        .byte %00000000, %00000000
        .byte %11111100, %11111100
        .byte %00000110, %11111110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110

; $05: UI_TILE_BOX_L (left vertical border)
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000

; $06: UI_TILE_BOX_R (right vertical border)
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110

; $07: UI_TILE_BOX_BL (rounded bevel bottom-left corner)
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01011111, %01100000
        .byte %01100000, %01111111
        .byte %00111111, %00111111
        .byte %00000000, %00000000

; $08: UI_TILE_BOX_B (bottom horizontal border)
        .byte %11111111, %00000000
        .byte %11111111, %00000000
        .byte %11111111, %00000000
        .byte %11111111, %00000000
        .byte %11111111, %00000000
        .byte %00000000, %11111111
        .byte %11111111, %11111111
        .byte %00000000, %00000000

; $09: UI_TILE_BOX_BR (rounded bevel bottom-right corner)
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %11111010, %00000110
        .byte %00000110, %11111110
        .byte %11111100, %11111100
        .byte %00000000, %00000000

; $0A: UI_TILE_CURSOR (right-pointing triangle arrow)
        _ui_glyph %01000000, %01100000, %01110000, %01111000, %01110000, %01100000, %01000000, %00000000

; $0B: UI_TILE_HEART (HP heart icon, color 2 body + color 3 highlight)
        .byte %11111111, %00000000
        .byte %10011001, %01100110
        .byte %01000001, %11111110
        .byte %00000001, %11111110
        .byte %10000011, %01111100
        .byte %11000111, %00111000
        .byte %11101111, %00010000
        .byte %11111111, %00000000

; $0C: UI_TILE_SWORD (ATK sword icon)
        _ui_glyph %00000010, %00000110, %00001100, %01011000, %00110000, %01010000, %10000000, %00000000

; $0D: UI_TILE_SHIELD (DEF shield icon)
        _ui_glyph %01111100, %11111110, %11010110, %11111110, %01111100, %00111000, %00010000, %00000000

; $0E: UI_TILE_BOOTS (MP / movement chevron icon)
        _ui_glyph %00000000, %01100110, %00110011, %00011001, %00110011, %01100110, %00000000, %00000000

; $0F: UI_TILE_STAR (Star / secret icon)
        _ui_glyph %00010000, %00111000, %11111110, %01111100, %00111000, %01101100, %10000010, %00000000

; $10: UI_TILE_HLINE (horizontal interior divider in color 2)
        .byte $FF,$00, $FF,$00, $FF,$00, $00,$FF, $FF,$00, $FF,$00, $FF,$00, $FF,$00

; $11: UI_TILE_VLINE (vertical interior divider in color 2)
        .byte %11101111,%00010000, %11101111,%00010000, %11101111,%00010000, %11101111,%00010000
        .byte %11101111,%00010000, %11101111,%00010000, %11101111,%00010000, %11101111,%00010000

; $12: UI_TILE_BAR_EMPTY
        .byte $FF,$00, $00,$FF, $FF,$00, $FF,$00, $FF,$00, $FF,$00, $00,$FF, $FF,$00

; $13: UI_TILE_BAR_HALF
        .byte $FF,$00, $00,$FF, $FF,$F0, $FF,$F0, $FF,$F0, $FF,$F0, $00,$FF, $FF,$00

; $14: UI_TILE_BAR_FULL
        .byte $FF,$00, $00,$FF, $FF,$FF, $FF,$FF, $FF,$FF, $FF,$FF, $00,$FF, $FF,$00

; $15..$1F: Reserved solid fill tiles (11 tiles)
        .repeat 11
        .byte $FF,$00, $FF,$00, $FF,$00, $FF,$00, $FF,$00, $FF,$00, $FF,$00, $FF,$00
        .endrep

; ------------------------------------------------------------------------------
; Direct-Mapped ASCII Font: $20 (' ') .. $5F ('_')
; ------------------------------------------------------------------------------
; $20 ' ' (solid window background fill)
        _ui_glyph %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000
; $21 '!'
        _ui_glyph %00011000, %00011000, %00011000, %00011000, %00011000, %00000000, %00011000, %00000000
; $22 '"'
        _ui_glyph %01101100, %01101100, %00100100, %00000000, %00000000, %00000000, %00000000, %00000000
; $23 '#'
        _ui_glyph %00100100, %01111110, %00100100, %00100100, %01111110, %00100100, %00000000, %00000000
; $24 '$'
        _ui_glyph %00011000, %00111110, %01011000, %00111100, %00011010, %01111100, %00011000, %00000000
; $25 '%'
        _ui_glyph %01100010, %01100100, %00001000, %00010000, %00100110, %01000110, %00000000, %00000000
; $26 '&'
        _ui_glyph %00111000, %01000100, %00111000, %01101010, %01000100, %01001010, %00110100, %00000000
; $27 '''
        _ui_glyph %00011000, %00011000, %00010000, %00000000, %00000000, %00000000, %00000000, %00000000
; $28 '('
        _ui_glyph %00001100, %00011000, %00110000, %00110000, %00110000, %00011000, %00001100, %00000000
; $29 ')'
        _ui_glyph %00110000, %00011000, %00001100, %00001100, %00001100, %00011000, %00110000, %00000000
; $2A '*'
        _ui_glyph %00000000, %01010100, %00111000, %11111110, %00111000, %01010100, %00000000, %00000000
; $2B '+'
        _ui_glyph %00000000, %00011000, %00011000, %01111110, %00011000, %00011000, %00000000, %00000000
; $2C ','
        _ui_glyph %00000000, %00000000, %00000000, %00000000, %00011000, %00011000, %00110000, %00000000
; $2D '-'
        _ui_glyph %00000000, %00000000, %00000000, %01111110, %00000000, %00000000, %00000000, %00000000
; $2E '.'
        _ui_glyph %00000000, %00000000, %00000000, %00000000, %00000000, %00011000, %00011000, %00000000
; $2F '/'
        _ui_glyph %00000010, %00000110, %00001100, %00011000, %00110000, %01100000, %01000000, %00000000

; $30..$39 '0'..'9'
; $30 '0'
        _ui_glyph %00111100, %01100110, %01101110, %01110110, %01100110, %01100110, %00111100, %00000000
; $31 '1'
        _ui_glyph %00011000, %00111000, %00011000, %00011000, %00011000, %00011000, %01111110, %00000000
; $32 '2'
        _ui_glyph %00111100, %01100110, %00000110, %00011100, %00110000, %01100000, %01111110, %00000000
; $33 '3'
        _ui_glyph %00111100, %01100110, %00000110, %00011100, %00000110, %01100110, %00111100, %00000000
; $34 '4'
        _ui_glyph %00001100, %00011100, %00111100, %01101100, %01111110, %00001100, %00001100, %00000000
; $35 '5'
        _ui_glyph %01111110, %01100000, %01111100, %00000110, %00000110, %01100110, %00111100, %00000000
; $36 '6'
        _ui_glyph %00111100, %01100000, %01111100, %01100110, %01100110, %01100110, %00111100, %00000000
; $37 '7'
        _ui_glyph %01111110, %01100110, %00000110, %00001100, %00011000, %00011000, %00011000, %00000000
; $38 '8'
        _ui_glyph %00111100, %01100110, %01100110, %00111100, %01100110, %01100110, %00111100, %00000000
; $39 '9'
        _ui_glyph %00111100, %01100110, %01100110, %00111110, %00000110, %00001100, %00111000, %00000000

; $3A ':'
        _ui_glyph %00000000, %00011000, %00011000, %00000000, %00011000, %00011000, %00000000, %00000000
; $3B ';'
        _ui_glyph %00000000, %00011000, %00011000, %00000000, %00011000, %00011000, %00110000, %00000000
; $3C '<'
        _ui_glyph %00001100, %00011000, %00110000, %01100000, %00110000, %00011000, %00001100, %00000000
; $3D '='
        _ui_glyph %00000000, %00000000, %01111110, %00000000, %01111110, %00000000, %00000000, %00000000
