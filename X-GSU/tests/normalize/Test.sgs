; SuperFX vector normalization test
; vector3_normalize

.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "libSFX.i"

.segment "GSURAM"
INPUT:
.res .sizeof(vector3)
OUTPUT:
.res .sizeof(vector3)
TEST_OUTPUT = OUTPUT

.segment "GSUCODE"
GSU_Code:

; Setup stack
init_stack
register v1, dst

test_setup:
	iwt r12, #33
	iwt r13, #test_call

test_call:
	gsu_stack_push r12
	gsu_stack_push r13
	iwt v1, #INPUT
	iwt dst, #OUTPUT
	call vector3_normalize v1, dst
	; LET MEMORY SETTLE
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
test_stop:
	nop
	nop
	gsu_stack_pop r13
	gsu_stack_pop r12
	loop
	nop
	stop
	nop

; Math routines
.include "../../gsu_maths/gsu_sqrt.i"
.include "../../gsu_maths/gsu_vector.i"
.include "../../gsu_maths/gsu_recip.i"
.include "../../gsu_maths/gsu_camera.i"
