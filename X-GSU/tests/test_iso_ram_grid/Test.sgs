; ==============================================================================
; TEST_ISO_RAM_GRID - Unit Test Suite for `gsu_iso_map.i` 16x16 Grids, Skirts,
; Panels & Architectural Archetypes from Game Pak RAM Bank $71
; ==============================================================================
.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "../../common/util.i"
.include "../../common/control.i"
.include "libSFX.i"

.segment "GSUCODE"
GSU_Entry:
    iwt r15, #GSU_Code
    nop

.include "../../gsu_iso/gsu_iso_map.i"

.segment "GSURAM"
.align 2
TEST_CASE_IDX:      .res 2
TEST_RESULT:        .res 32
TEST_TRACE_BUF:     .res 516        ; up to 256 cell trace words (512B + guard)

.segment "GSUCODE"

function clear_screen_buf
    ibt r0, #0
    ramb
    iwt r1, #$A000
    iwt r12, #($2800 / 2)
    iwt r13, #@clr
    ibt r0, #0
@clr:
    stw (r1)
    inc r1
    loop
    inc r1
    return
endfunction

; Helper: fill a 32x32 slice at Bank-$71 `r1` (pitch 64) with solid color `r2`
function fill_tex_32x32_b71 base_off, col_val
    register base_off = r1, col_val = r2
    ibt r0, #1
    ramb
    move r4, base_off
    iwt r5, #32
@row_l:
    move r6, r4
    iwt r12, #32
    iwt r13, #@col_l
    move r0, col_val
@col_l:
    stb (r6)
    loop
    inc r6
    iwt r7, #64
    with r4
    add r7
    dec r5
    bne @row_l
    nop
    ibt r0, #0
    ramb
    return
endfunction

; Helper: stage 4-entry `.tab` (stride_shift=6, width=64) at $71:8000
;   ID 0: $0000 32x32 (color 3)
;   ID 1: $1000 32x32 (color 5)
;   ID 2: $2000 32x16 (color 8, panel)
;   ID 3: $3000 16x32 (color 4, foliage)
function stage_test_atlas_and_tab
    iwt r1, #$0000
    iwt r2, #3
    call fill_tex_32x32_b71 r1, r2

    iwt r1, #$1000
    iwt r2, #5
    call fill_tex_32x32_b71 r1, r2

    iwt r1, #$2000
    iwt r2, #8
    call fill_tex_32x32_b71 r1, r2

    iwt r1, #$3000
    iwt r2, #4
    call fill_tex_32x32_b71 r1, r2

    ibt r0, #1
    ramb
    iwt r1, #BANK71_TAB_ADDR
    iwt r0, #SFX_TAB_MAGIC
    stw (r1)
    inc r1
    inc r1
    iwt r0, #4
    stw (r1)                ; entry_count = 4
    inc r1
    inc r1
    iwt r0, #64
    stw (r1)                ; atlas_width = 64
    inc r1
    inc r1
    iwt r0, #6
    stw (r1)                ; stride_shift = 6
    inc r1
    inc r1

    ; Entry 0: $0000, 32x32
    iwt r0, #$0000
    stw (r1)
    inc r1
    inc r1
    iwt r0, #31
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(31 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((31 << 6) | 63)
    stw (r1)
    inc r1
    inc r1

    ; Entry 1: $1000, 32x32
    iwt r0, #$1000
    stw (r1)
    inc r1
    inc r1
    iwt r0, #31
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(31 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((31 << 6) | 63)
    stw (r1)
    inc r1
    inc r1

    ; Entry 2: $2000, 32x16
    iwt r0, #$2000
    stw (r1)
    inc r1
    inc r1
    iwt r0, #31
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(15 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((15 << 6) | 63)
    stw (r1)
    inc r1
    inc r1

    ; Entry 3: $3000, 16x32
    iwt r0, #$3000
    stw (r1)
    inc r1
    inc r1
    iwt r0, #15
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(31 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((31 << 6) | 63)
    stw (r1)

    ibt r0, #0
    ramb
    return
endfunction

; Helper: write empty flat `.map` of size (cols=r1, rows=r2) at $71:8808
function stage_flat_map_b71 cols_in, rows_in
    register cols_in = r1, rows_in = r2
    from cols_in
    umult rows_in
    move r4, r0             ; r4 = cols * rows
    with r4
    add r4
    with r4
    add r4                  ; r4 = (cols * rows) * 4 words

    ibt r0, #1
    ramb
    iwt r3, #BANK71_MAP_ADDR
    from cols_in
    stb (r3)
    inc r3
    from rows_in
    stb (r3)
    inc r3
    ibt r0, #0
    stw (r3)
    inc r3
    inc r3
    stw (r3)
    inc r3
    inc r3
    stw (r3)
    inc r3
    inc r3

    move r12, r4
    iwt r13, #@fill_w
    ibt r0, #0
@fill_w:
    stw (r3)
    inc r3
    loop
    inc r3

    ibt r0, #0
    ramb
    return
endfunction

.export GSU_Code
GSU_Code:
    init_stack
    ibt r0, #$04
    romb
    ibt r0, #0
    ramb

test_setup:
    iwt r12, #4
    iwt r13, #test_call

test_call:
    gsu_stack_push r12
    gsu_stack_push r13

    lm r9, (TEST_CASE_IDX)

    iwt r8, #TEST_RESULT
    iwt r12, #16
    iwt r13, #clear_res
    ibt r0, #0
clear_res:
    stw (r8)
    inc r8
    loop
    inc r8

    from r9
    sub #1
    bne @check_2
    nop
    iwt r13, #run_case_1
    jmp r13
    nop
@check_2:
    from r9
    sub #2
    bne @check_3
    nop
    iwt r13, #run_case_2
    jmp r13
    nop
@check_3:
    from r9
    sub #3
    bne @check_4
    nop
    iwt r13, #run_case_3
    jmp r13
    nop
@check_4:
    iwt r13, #run_case_4
    jmp r13
    nop

; ==============================================================================
; Case 1: Non-Square `6x4` Traversal Order Across All 4 Yaw Quadrants
; ==============================================================================
run_case_1:
    call stage_test_atlas_and_tab
    iwt r1, #6
    iwt r2, #4
    call stage_flat_map_b71 r1, r2

    iwt r0, #SFX_LOAD_MODE_LEVEL
    sm (GSU_LOAD_MODE), r0
    call gsu_iso_import_bank71

    ; --- Q0: yaw = 15 (cos > 0, sin > 0) -> first=$0000, last=$0503 ---
    iwt r1, #ISO_CAM
    iwt r2, #15
    call iso_camera_set_yaw r1, r2
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    call gsu_iso_update_origin r1, r2
    iwt r1, #ISO_CAM
    iwt r2, #ISO_BASIS
    iwt r3, #LATTICE_V2
    iwt r4, #ARCH_TRAPS
    iwt r5, #CACHED_YAW
    call gsu_iso_compile_archetypes r1, r2, r3, r4, r5
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #$FFFF
    iwt r6, #TEST_TRACE_BUF
    call gsu_iso_render r1, r2, r3, r4, r5, r6

    lm r4, (gsu_iso_render_frame + map_render_frame::debug_count) ; 24
    lm r5, (TEST_TRACE_BUF + 0)                                   ; $0000
    lm r6, (TEST_TRACE_BUF + 46)                                  ; $0503
    gsu_stack_push r4
    gsu_stack_push r5
    gsu_stack_push r6

    ; --- Q1: yaw = 45 (cos < 0, sin > 0) -> first=$0003, last=$0500 ---
    iwt r1, #ISO_CAM
    iwt r2, #45
    call iso_camera_set_yaw r1, r2
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    call gsu_iso_update_origin r1, r2
    iwt r1, #ISO_CAM
    iwt r2, #ISO_BASIS
    iwt r3, #LATTICE_V2
    iwt r4, #ARCH_TRAPS
    iwt r5, #CACHED_YAW
    call gsu_iso_compile_archetypes r1, r2, r3, r4, r5
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #$FFFF
    iwt r6, #TEST_TRACE_BUF
    call gsu_iso_render r1, r2, r3, r4, r5, r6
    lm r7, (TEST_TRACE_BUF + 0)     ; $0003
    gsu_stack_push r7

    ; --- Q2: yaw = 75 (cos < 0, sin < 0) -> first=$0503, last=$0000 ---
    iwt r1, #ISO_CAM
    iwt r2, #75
    call iso_camera_set_yaw r1, r2
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    call gsu_iso_update_origin r1, r2
    iwt r1, #ISO_CAM
    iwt r2, #ISO_BASIS
    iwt r3, #LATTICE_V2
    iwt r4, #ARCH_TRAPS
    iwt r5, #CACHED_YAW
    call gsu_iso_compile_archetypes r1, r2, r3, r4, r5
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #$FFFF
    iwt r6, #TEST_TRACE_BUF
    call gsu_iso_render r1, r2, r3, r4, r5, r6
    lm r9, (TEST_TRACE_BUF + 0)     ; $0503
    gsu_stack_push r9

    ; --- Q3: yaw = 105 (cos > 0, sin < 0) -> first=$0500, last=$0003 ---
    iwt r1, #ISO_CAM
    iwt r2, #105
    call iso_camera_set_yaw r1, r2
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    call gsu_iso_update_origin r1, r2
    iwt r1, #ISO_CAM
    iwt r2, #ISO_BASIS
    iwt r3, #LATTICE_V2
    iwt r4, #ARCH_TRAPS
    iwt r5, #CACHED_YAW
    call gsu_iso_compile_archetypes r1, r2, r3, r4, r5
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #$FFFF
    iwt r6, #TEST_TRACE_BUF
    call gsu_iso_render r1, r2, r3, r4, r5, r6
    lm r11, (TEST_TRACE_BUF + 0)    ; $0500

    gsu_stack_pop r9
    gsu_stack_pop r7
    gsu_stack_pop r6
    gsu_stack_pop r5
    gsu_stack_pop r4

    iwt r8, #TEST_RESULT
    from r4
    stw (r8)                ; [0]: count == 120
    inc r8
    inc r8
    from r5
    stw (r8)                ; [1]: Q0 first == $0000
    inc r8
    inc r8
    from r6
    stw (r8)                ; [2]: Q0 last == $0B09
    inc r8
    inc r8
    from r7
    stw (r8)                ; [3]: Q1 first == $0009
    inc r8
    inc r8
    from r9
    stw (r8)                ; [4]: Q2 first == $0B09
    inc r8
    inc r8
    from r11
    stw (r8)                ; [5]: Q3 first == $0B00

    iwt r13, #test_done
    jmp r13
    nop

; ==============================================================================
; Case 2: Maximum `16x16` (`256` Cells, `2,056` Bytes) Traversal & Corner (15,15)
; ==============================================================================
run_case_2:
    call clear_screen_buf
    call stage_test_atlas_and_tab
    iwt r1, #16
    iwt r2, #16
    call stage_flat_map_b71 r1, r2

    ; Set corner cell (15, 15) -> index 255 -> $71:(8808 + 8 + 2040) = $71:9008
    ; top_tex_id (+2) = 1 (color 5) instead of 0 (color 3)!
    ibt r0, #1
    ramb
    iwt r1, #(BANK71_MAP_ADDR + 8 + (255 * 8) + 2)
    ibt r0, #1
    stb (r1)
    ibt r0, #0
    ramb

    iwt r0, #SFX_LOAD_MODE_LEVEL
    sm (GSU_LOAD_MODE), r0
    call gsu_iso_import_bank71

    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    call gsu_iso_update_origin r1, r2

    iwt r1, #ISO_CAM
    iwt r2, #ISO_BASIS
    iwt r3, #LATTICE_V2
    iwt r4, #ARCH_TRAPS
    iwt r5, #CACHED_YAW
    call gsu_iso_compile_archetypes r1, r2, r3, r4, r5

    ; Full 256-cell traversal trace
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #$FFFF
    iwt r6, #TEST_TRACE_BUF
    call gsu_iso_render r1, r2, r3, r4, r5, r6

    lm r4, (gsu_iso_render_frame + map_render_frame::debug_count) ; visible cells in 256x160 (> 180)
    lm r5, (MAP_BUF + 0)                                          ; rows:cols == $1010 (16x16)
    gsu_stack_push r4
    gsu_stack_push r5

    ; Position origin directly so cell (15, 15) at yaw=0 (cos=1, sin=0 -> Sx=(32,0), Sz=(0,16))
    ; lands inside Pass 0: set yaw=0, origin_x = 64 - 15*32 = -416 ($FE60), origin_z = 60 - 15*16 = -180 ($FF4C)
    iwt r1, #ISO_CAM
    iwt r2, #0
    call iso_camera_set_yaw r1, r2

    iwt r1, #ISO_CAM
    iwt r2, #ISO_BASIS
    iwt r3, #LATTICE_V2
    iwt r4, #ARCH_TRAPS
    iwt r5, #CACHED_YAW
    call gsu_iso_compile_archetypes r1, r2, r3, r4, r5

    iwt r0, #$FE60          ; -416 -> cell (15,15) anchor_x = 64
    sm (MAP_BUF + 2), r0
    iwt r0, #$FF4C          ; -180 -> cell (15,15) anchor_y = 60
    sm (MAP_BUF + 4), r0

    call clear_screen_buf
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #0
    iwt r6, #0
    call gsu_iso_render r1, r2, r3, r4, r5, r6

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    gsu_stack_pop r5
    gsu_stack_pop r4

    iwt r8, #TEST_RESULT
    from r4
    stw (r8)                ; [0]: count == 256
    inc r8
    inc r8
    from r5
    stw (r8)                ; [1]: last trace word == $0F0F
    inc r8
    inc r8
    iwt r1, #80             ; center of cell (15,15) floor [64..96), y=[60..76)
    iwt r2, #68
    rpix
    stw (r8)                ; [2]: cell (15,15) pixel == 5 (tex ID 1)
    inc r8
    inc r8
    iwt r1, #48             ; neighbor cell (14,15) floor [32..64), y=[60..76)
    iwt r2, #68
    rpix
    stw (r8)                ; [3]: cell (14,15) pixel == 3 (tex ID 0)

    iwt r13, #test_done
    jmp r13
    nop

; ==============================================================================
; Case 3: Stepped Skirts + `2h` Edge Panels (`PANEL_S | PANEL_E | PANEL_2H`)
; ==============================================================================
run_case_3:
    call clear_screen_buf
    call stage_test_atlas_and_tab
    iwt r1, #4
    iwt r2, #4
    call stage_flat_map_b71 r1, r2

    ; Elevate cell (1,1) -> index (1*4 + 1) = 5 -> offset 8 + 40 = 48:
    ; base_height = 2, arch = PRIM_FLAT, top = 0 (col 3), skirt = 1 (col 5),
    ; panel_tex = 2 (col 8), panel_flags = (PANEL_S | PANEL_E | PANEL_2H) = $16
    ibt r0, #1
    ramb
    iwt r1, #(BANK71_MAP_ADDR + 48)
    ibt r0, #2              ; +0: base_height = 2
    stb (r1)
    inc r1
    ibt r0, #PRIM_FLAT      ; +1: archetype_id = 0
    stb (r1)
    inc r1
    ibt r0, #0              ; +2: top_tex = 0 (color 3)
    stb (r1)
    inc r1
    ibt r0, #1              ; +3: skirt_tex = 1 (color 5)
    stb (r1)
    inc r1
    ibt r0, #2              ; +4: panel_tex = 2 (color 8)
    stb (r1)
    inc r1
    ibt r0, #(PANEL_S | PANEL_E | PANEL_TALL_2H)
    stb (r1)
    ibt r0, #0
    ramb

    iwt r0, #SFX_LOAD_MODE_LEVEL
    sm (GSU_LOAD_MODE), r0
    call gsu_iso_import_bank71

    ; Yaw = 15 (isometric 45 deg view where both S and E faces are camera-facing!)
    iwt r1, #ISO_CAM
    iwt r2, #15
    call iso_camera_set_yaw r1, r2

    ; Center camera on Pass 0 (center_x = 64, center_y = 90) so entire 4x4 fits in [0..127]!
    iwt r0, #64
    sm (ISO_CAM + 6), r0
    iwt r0, #90
    sm (ISO_CAM + 8), r0

    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    call gsu_iso_update_origin r1, r2

    iwt r1, #ISO_CAM
    iwt r2, #ISO_BASIS
    iwt r3, #LATTICE_V2
    iwt r4, #ARCH_TRAPS
    iwt r5, #CACHED_YAW
    call gsu_iso_compile_archetypes r1, r2, r3, r4, r5

    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #0
    iwt r6, #0
    call gsu_iso_render r1, r2, r3, r4, r5, r6

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    ; Scan Pass 0 region (x=20..108, y=20..130) to count pixels of color 3 (floor),
    ; color 5 (skirt), and color 8 (2h parapet panel)!
    iwt r4, #0              ; count color 3 (floor)
    iwt r5, #0              ; count color 5 (skirt)
    iwt r6, #0              ; count color 8 (panel)

    iwt r2, #20             ; y = 20..129
@c3_scan_y:
    iwt r1, #20             ; x = 20..107
@c3_scan_x:
    rpix                    ; r0 = pixel(r1, r2); preserve in r9 so `sub` doesn't clobber it!
    move r9, r0
    from r9
    sub #3
    bne :+
    nop
    inc r4
:   from r9
    sub #5
    bne :+
    nop
    inc r5
:   from r9
    sub #8
    bne :+
    nop
    inc r6
:   inc r1
    iwt r7, #108
    from r1
    cmp r7
    blt @c3_scan_x
    nop

    inc r2
    iwt r7, #130
    from r2
    cmp r7
    blt @c3_scan_y
    nop

    iwt r8, #TEST_RESULT
    from r4
    stw (r8)                ; [0]: floor_px > 0
    inc r8
    inc r8
    from r5
    stw (r8)                ; [1]: skirt_px > 0
    inc r8
    inc r8
    from r6
    stw (r8)                ; [2]: panel_px > 0

    iwt r13, #test_done
    jmp r13
    nop

; ==============================================================================
; Case 4: Architectural Archetypes (`PRIM_WEDGE_STRAIGHT`, `PRIM_PILLAR`, `PRIM_FOLIAGE_CROSS`)
; ==============================================================================
run_case_4:
    call clear_screen_buf
    call stage_test_atlas_and_tab
    iwt r1, #4
    iwt r2, #4
    call stage_flat_map_b71 r1, r2

    ibt r0, #1
    ramb
    ; Cell (1,0) -> offset 8 + 32 = 40: PRIM_WEDGE_STRAIGHT (1), skirt_tex = 1 (color 5)
    iwt r1, #(BANK71_MAP_ADDR + 40)
    ibt r0, #0
    stb (r1)
    inc r1
    ibt r0, #PRIM_WEDGE_STRAIGHT
    stb (r1)
    inc r1
    ibt r0, #1              ; top_tex = 1 (color 5)
    stb (r1)
    inc r1
    ibt r0, #1
    stb (r1)

    ; Cell (0,1) -> offset 8 + 8 = 16: PRIM_PILLAR (10), skirt_tex = 2 (color 8)
    iwt r1, #(BANK71_MAP_ADDR + 16)
    ibt r0, #0
    stb (r1)
    inc r1
    ibt r0, #PRIM_PILLAR
    stb (r1)
    inc r1
    ibt r0, #0              ; floor = 0 (color 3)
    stb (r1)
    inc r1
    ibt r0, #2              ; pillar sides = 2 (color 8)
    stb (r1)

    ; Cell (1,1) -> offset 8 + 40 = 48: PRIM_FOLIAGE_CROSS (11), panel_tex = 3 (color 4)
    iwt r1, #(BANK71_MAP_ADDR + 48)
    ibt r0, #0
    stb (r1)
    inc r1
    ibt r0, #PRIM_FOLIAGE_CROSS
    stb (r1)
    inc r1
    ibt r0, #0              ; floor = 0 (color 3)
    stb (r1)
    inc r1
    ibt r0, #1
    stb (r1)
    inc r1
    ibt r0, #3              ; panel_tex = 3 (color 4 foliage!)
    stb (r1)
    ibt r0, #0
    ramb

    iwt r0, #SFX_LOAD_MODE_LEVEL
    sm (GSU_LOAD_MODE), r0
    call gsu_iso_import_bank71

    iwt r1, #ISO_CAM
    iwt r2, #15
    call iso_camera_set_yaw r1, r2
    iwt r0, #64
    sm (ISO_CAM + 6), r0
    iwt r0, #90
    sm (ISO_CAM + 8), r0

    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    call gsu_iso_update_origin r1, r2

    iwt r1, #ISO_CAM
    iwt r2, #ISO_BASIS
    iwt r3, #LATTICE_V2
    iwt r4, #ARCH_TRAPS
    iwt r5, #CACHED_YAW
    call gsu_iso_compile_archetypes r1, r2, r3, r4, r5

    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #0
    iwt r6, #0
    call gsu_iso_render r1, r2, r3, r4, r5, r6

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    ; Count wedge color 5, pillar color 8, foliage color 4
    iwt r4, #0
    iwt r5, #0
    iwt r6, #0
    iwt r2, #20
@c4_scan_y:
    iwt r1, #20
@c4_scan_x:
    rpix
    move r9, r0
    from r9
    sub #5
    bne :+
    nop
    inc r4
:   from r9
    sub #8
    bne :+
    nop
    inc r5
:   from r9
    sub #4
    bne :+
    nop
    inc r6
:   inc r1
    iwt r7, #108
    from r1
    cmp r7
    blt @c4_scan_x
    nop
    inc r2
    iwt r7, #130
    from r2
    cmp r7
    blt @c4_scan_y
    nop

    iwt r8, #TEST_RESULT
    lm r0, (gsu_iso_active_arch_mask)
    stw (r8)                ; [0]: active_arch_mask == (1<<0)|(1<<1)|(1<<10)|(1<<11) = $0C03
    inc r8
    inc r8
    from r4
    stw (r8)                ; [1]: wedge_px > 0
    inc r8
    inc r8
    from r5
    stw (r8)                ; [2]: pillar_px > 0
    inc r8
    inc r8
    from r6
    stw (r8)                ; [3]: foliage_px > 0

test_done:
    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
test_stop:
    nop
    nop
    gsu_stack_pop r13
    gsu_stack_pop r12
    loop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    stop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
