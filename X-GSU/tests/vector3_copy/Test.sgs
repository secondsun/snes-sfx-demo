; SuperFX vector3_copy unit test

.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "libSFX.i"

.segment "GSURAM"
INPUT:
.res .sizeof(vector3)
OUTPUT:
.res .sizeof(vector3)

.segment "GSUCODE"
GSU_Code:

; Setup stack
init_stack

test_setup:
	iwt r12, #6
	iwt r13, #test_call

test_call:
	gsu_stack_push r12
	gsu_stack_push r13

	iwt r0, #INPUT
	iwt r2, #OUTPUT
	call vector3_copy

	; Let memory settle
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop

test_stop:
	nop
	nop
	gsu_stack_pop r13
	gsu_stack_pop r12
	loop
	nop
	stop
	nop

; Include math functions
.include "../../gsu_maths/gsu_sqrt.i"
.include "../../gsu_maths/gsu_vector.i"
.include "../../gsu_maths/gsu_recip.i"
.include "../../gsu_maths/gsu_camera.i"
