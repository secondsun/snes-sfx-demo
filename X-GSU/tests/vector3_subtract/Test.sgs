; SuperFX vector3_subtract unit test

.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "libSFX.i"

.segment "GSURAM"
INPUT_A:
.res .sizeof(vector3)
INPUT_B:
.res .sizeof(vector3)
TEST_OUTPUT:
.res .sizeof(vector3)
OUTPUT = TEST_OUTPUT

.segment "GSUCODE"
GSU_Code:

; Setup stack
init_stack
register v1, v2, dst

test_setup:
	iwt r12, #8
	iwt r13, #test_call

test_call:
	gsu_stack_push r12
	gsu_stack_push r13

	iwt v1, #INPUT_A
	iwt v2, #INPUT_B
	iwt dst, #TEST_OUTPUT
	call vector3_subtract v1, v2, dst

	; Let memory settle
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop

test_stop:
	nop
	nop
	gsu_stack_pop r13
	gsu_stack_pop r12
	loop
	nop
	stop
	nop

; Include math functions
.include "../../gsu_maths/gsu_sqrt.i"
.include "../../gsu_maths/gsu_vector.i"
.include "../../gsu_maths/gsu_recip.i"
.include "../../gsu_maths/gsu_camera.i"
