; SuperFX
; Test plot_texel by rendering TEXTURES_graphics.bin

.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "libSFX.i"

.segment "GSURAM"
screenbuffer = $4000
screenbuffer_len = $2800

GSU_FRAME_HALF:
.export GSU_FRAME_HALF
    .res 2

.segment "GSUCODE"
GSU_Code:

    init_stack

test_setup:
    nop
    nop

    ; Clear screenbuffer in GSURAM
    iwt r1, #screenbuffer
    iwt r12, #($2800 / 2)
    iwt r0, #0
    cache
    move r13, r15
        stw (r1)
        inc r1
        loop
        inc r1
    nop

    ; Set ROM bank to Bank 4 where TEXTURES_graphics.bin is located
    ibt r0, #4
    romb

    ; Enable plotting opaque color (bit 0 = 1 so color 0 also plots)
    ibt r0, #1
    cmode

test_start:
    register curr_x, curr_y, u_val, v_val, tbl_idx
    register limit32, limit64, limit96

    ibt limit32, #32
    ibt limit64, #64
    ibt limit96, #96

    ; Row 0..31 (two textures: roof at x=0..31, grass at x=32..63)
    iwt curr_y, #0
@row_loop_0_31:
    move v_val, curr_y

    ; Left texture: roof (table_index = 0, columns 0..31)
    iwt curr_x, #0
@col_loop_roof:
    move u_val, curr_x
    iwt tbl_idx, #0
    call plot_texel curr_x, curr_y, u_val, v_val, tbl_idx
    with curr_x
    inc curr_x
    from curr_x
    cmp limit32
    bne @col_loop_roof
    nop

    ; Right texture: grass (table_index = 1, columns 32..63)
    move curr_x, limit32
@col_loop_grass:
    from curr_x
    to u_val
    sub limit32
    iwt tbl_idx, #1
    call plot_texel curr_x, curr_y, u_val, v_val, tbl_idx
    with curr_x
    inc curr_x
    from curr_x
    cmp limit64
    bne @col_loop_grass
    nop

    with curr_y
    inc curr_y
    from curr_y
    cmp limit32
    bne @row_loop_0_31
    nop

    ; Row 32..63 (two textures: sand at x=0..31, water at x=32..63)
    move curr_y, limit32
@row_loop_32_63:
    from curr_y
    to v_val
    sub limit32

    ; Left texture: sand (table_index = 3, columns 0..31)
    iwt curr_x, #0
@col_loop_sand:
    move u_val, curr_x
    iwt tbl_idx, #3
    call plot_texel curr_x, curr_y, u_val, v_val, tbl_idx
    with curr_x
    inc curr_x
    from curr_x
    cmp limit32
    bne @col_loop_sand
    nop

    ; Right texture: water (table_index = 4, columns 32..63)
    move curr_x, limit32
@col_loop_water:
    from curr_x
    to u_val
    sub limit32
    iwt tbl_idx, #4
    call plot_texel curr_x, curr_y, u_val, v_val, tbl_idx
    with curr_x
    inc curr_x
    from curr_x
    cmp limit64
    bne @col_loop_water
    nop

    with curr_y
    inc curr_y
    from curr_y
    cmp limit64
    bne @row_loop_32_63
    nop

    ; Row 64..95 (one texture: stone at x=0..31)
    move curr_y, limit64
@row_loop_64_95:
    from curr_y
    to v_val
    sub limit64

    ; Left texture: stone (table_index = 5, columns 0..31)
    iwt curr_x, #0
@col_loop_stone:
    move u_val, curr_x
    iwt tbl_idx, #5
    call plot_texel curr_x, curr_y, u_val, v_val, tbl_idx
    with curr_x
    inc curr_x
    from curr_x
    cmp limit32
    bne @col_loop_stone
    nop

    with curr_y
    inc curr_y
    from curr_y
    cmp limit96
    bne @row_loop_64_95
    nop

    ; Flush GSU pixel cache to RAM
    rpix
    rpix

    ; Let memory settle (8 NOPs)
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

test_stop:
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    stop
    nop

; Includes that need to be in GSURAM as part of GSUCODE
.include "../../gsu_maths/gsu_recip.i"
.include "../../IsoEngine/triangle/drawTriangle.i"
