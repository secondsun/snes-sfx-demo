; 16-bit 0.16-fixed point reciprocal
; reciprocal

.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "../../gsu_maths/gsu_trig.i"
.include "libSFX.i"

.segment "GSURAM"

INPUT:
.res 4
OUTPUT:
.res 4
.segment "GSUCODE"
GSU_Code:
;Setup stack
init_stack
register sin_out, cos_out

;This label represents the memory address that begins test setup
; The lua script will execute setup here
test_setup:
	iwt r12, #120 ; loop 120 times 
	iwt r13, #test_call

test_call:
	gsu_stack_push r12
	gsu_stack_push r13

	sin_lookup_rom r12, sin_out
	nop
	sm (OUTPUT), sin_out
	cos_lookup_rom r12, cos_out
	nop
	sm (OUTPUT+2), cos_out

	; Let memory settle
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop

test_stop:
	nop
	nop
	gsu_stack_pop r13
	gsu_stack_pop r12
	loop
	nop
	stop
	nop



;Code goes in code segment
.include "../../gsu_maths/gsu_sqrt.i"
.include "../../gsu_maths/gsu_vector.i"
.include "../../gsu_maths/gsu_recip.i"
.include "../../gsu_maths/gsu_camera.i"

