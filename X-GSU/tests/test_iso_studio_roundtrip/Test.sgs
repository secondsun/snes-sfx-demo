; ==============================================================================
; TEST_ISO_STUDIO_ROUNDTRIP - End-to-End `sfx-studio` CLI -> 65816 Loader ->
; Bank `$71` -> GSU Import & Two-Pass Hardware Rasterization Verification
; ==============================================================================
.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "../../common/util.i"
.include "../../common/control.i"
.include "libSFX.i"

.segment "GSUCODE"
GSU_Entry:
    iwt r15, #GSU_Code
    nop

.include "../../gsu_iso/gsu_iso_map.i"

.segment "GSURAM"
.align 2
CPU_STAGE_SNAP:     .res 8
.export CPU_STAGE_SNAP
TEST_CASE_IDX:      .res 2
TEST_RESULT:        .res 32
BANK70_SENTINEL:    .res 2

.segment "GSUCODE"

function clear_screen_buf
    ibt r0, #0
    ramb
    iwt r1, #$A000
    iwt r12, #($2800 / 2)
    iwt r13, #@clr
    ibt r0, #0
@clr:
    stw (r1)
    inc r1
    loop
    inc r1
    return
endfunction

; Accumulates 6 material family pixel counts from the active 128x160 half-screen buffer
; into TEST_RESULT[0..5].
function accum_half_materials
    ibt r0, #0
    ramb
    cache
    iwt r2, #0
@scan_y:
    iwt r1, #0
@scan_x:
    rpix
    moves r9, r0
    bne :+
    nop
    iwt r15, #@next_px
    nop
:
    ; grass: 2 or 3 -> slot +0
    from r9
    sub #2
    beq @do_grass
    nop
    from r9
    sub #3
    bne @chk_foliage
    nop
@do_grass:
    iwt r8, #(TEST_RESULT + 0)
    iwt r15, #@inc_slot
    nop

@chk_foliage:
    ; foliage: 4 or 7 -> slot +10
    from r9
    sub #4
    beq @do_foliage
    nop
    from r9
    sub #7
    bne @chk_stone
    nop
@do_foliage:
    iwt r8, #(TEST_RESULT + 10)
    iwt r15, #@inc_slot
    nop

@chk_stone:
    ; stone: 5 or 6 -> slot +2
    from r9
    sub #5
    beq @do_stone
    nop
    from r9
    sub #6
    bne @chk_water
    nop
@do_stone:
    iwt r8, #(TEST_RESULT + 2)
    iwt r15, #@inc_slot
    nop

@chk_water:
    ; water: 8 or 9 -> slot +4
    from r9
    sub #8
    beq @do_water
    nop
    from r9
    sub #9
    bne @chk_roof
    nop
@do_water:
    iwt r8, #(TEST_RESULT + 4)
    iwt r15, #@inc_slot
    nop

@chk_roof:
    ; roof (wedge + pillar): 11 or 12 -> slot +6
    from r9
    sub #11
    beq @do_roof
    nop
    from r9
    sub #12
    bne @chk_parapet
    nop
@do_roof:
    iwt r8, #(TEST_RESULT + 6)
    iwt r15, #@inc_slot
    nop

@chk_parapet:
    ; parapet: 13 or 14 -> slot +8
    from r9
    sub #13
    beq @do_parapet
    nop
    from r9
    sub #14
    bne @next_px
    nop
@do_parapet:
    iwt r8, #(TEST_RESULT + 8)

@inc_slot:
    ldw (r8)
    inc r0
    stw (r8)

@next_px:
    inc r1
    inc r1
    iwt r7, #128
    from r1
    cmp r7
    bge :+
    nop
    iwt r15, #@scan_x
    nop
:   inc r2
    inc r2
    iwt r7, #160
    from r2
    cmp r7
    bge :+
    nop
    iwt r15, #@scan_y
    nop
:   return
endfunction

; Renders both Pass 0 [0..127] and Pass 1 [128..255] at `yaw = r1` and accumulates
; material family pixel counts across both 128x160 half-screen passes into TEST_RESULT[0..5].
function render_full_frame_at_yaw target_yaw
    register target_yaw = r1
    move r2, target_yaw
    iwt r1, #ISO_CAM
    call iso_camera_set_yaw r1, r2

    iwt r1, #128
    sm (ISO_CAM + 6), r1
    iwt r1, #80
    sm (ISO_CAM + 8), r1

    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    call gsu_iso_update_origin r1, r2

    iwt r1, #ISO_CAM
    iwt r2, #ISO_BASIS
    iwt r3, #LATTICE_V2
    iwt r4, #ARCH_TRAPS
    iwt r5, #CACHED_YAW
    call gsu_iso_compile_archetypes r1, r2, r3, r4, r5

    ; Zero TEST_RESULT[0..5] before accumulating Pass 0 + Pass 1
    ibt r0, #0
    ramb
    iwt r8, #TEST_RESULT
    ibt r0, #0
    stw (r8)
    inc r8
    inc r8
    stw (r8)
    inc r8
    inc r8
    stw (r8)
    inc r8
    inc r8
    stw (r8)
    inc r8
    inc r8
    stw (r8)
    inc r8
    inc r8
    stw (r8)

    ; Pass 0: X in [0..127]
    call clear_screen_buf
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #0
    iwt r6, #0
    call gsu_iso_render r1, r2, r3, r4, r5, r6
    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    call accum_half_materials

    ; Pass 1: X in [128..255] (frame_half = 1, debug_order_ptr = 0)
    call clear_screen_buf
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #1
    iwt r6, #0
    call gsu_iso_render r1, r2, r3, r4, r5, r6
    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    call accum_half_materials
    return
endfunction

GSU_Code:
.export GSU_Code
    init_stack
    ibt r0, #$04
    romb
    ibt r0, #0
    ramb
    ibt r0, #$00
    cmode

    iwt r12, #4
    iwt r13, #test_loop
    nop

test_setup:
    nop
    nop

test_loop:
    gsu_stack_push r12
    gsu_stack_push r13

    ibt r0, #0
    ramb
    iwt r0, #$BEEF
    sm (BANK70_SENTINEL), r0

    iwt r1, #TEST_CASE_IDX
    to r4
    ldw (r1)

    from r4
    sub #1
    bne @check_c2
    nop
    iwt r15, #case_1
    nop
@check_c2:
    from r4
    sub #2
    bne @check_c3
    nop
    iwt r15, #case_2
    nop
@check_c3:
    from r4
    sub #3
    bne @check_c4
    nop
    iwt r15, #case_3
    nop
@check_c4:
    iwt r15, #case_4
    nop

; ------------------------------------------------------------------------------
; Case 1: Verify 65816 `SFX_LOAD_LEVEL` Bank-$71 Staging + PPU CGRAM Upload
; ------------------------------------------------------------------------------
case_1:
    ibt r0, #1
    ramb
    iwt r1, #BANK71_TAB_ADDR
    to r4
    ldw (r1)                        ; $71:8000 magic ($5453)
    iwt r1, #(BANK71_PAL_ADDR + 4)
    to r5
    ldw (r1)                        ; $71:9014 palette[2] ($2247)

    ibt r0, #0
    ramb
    iwt r8, #TEST_RESULT
    lm r0, (CPU_STAGE_SNAP + 0)     ; [0]: PPU CGRAM[2] readback ($2247)
    stw (r8)
    inc r8
    inc r8
    lm r0, (CPU_STAGE_SNAP + 2)     ; [1]: sfx_atlas_load_count == 1
    stw (r8)
    inc r8
    inc r8
    lm r0, (CPU_STAGE_SNAP + 4)     ; [2]: sfx_resident_atlas_id == 0
    stw (r8)
    inc r8
    inc r8
    from r4                         ; [3]: $71:8000 == $5453
    stw (r8)
    inc r8
    inc r8
    from r5                         ; [4]: $71:9014 == $2247
    stw (r8)
    inc r8
    inc r8
    lm r0, (GSU_LOAD_MODE)          ; [5]: GSU_LOAD_MODE == 1 (SFX_LOAD_MODE_LEVEL)
    stw (r8)
    iwt r15, #test_done
    nop

; ------------------------------------------------------------------------------
; Case 2: GSU `gsu_iso_import_bank71` Validation on Studio-Packed `.tab` + `.map`
; ------------------------------------------------------------------------------
case_2:
    call gsu_iso_import_bank71

    iwt r8, #TEST_RESULT
    from r3
    stw (r8)                        ; [0]: import status == 0
    inc r8
    inc r8
    lm r0, (gsu_runtime_tab_count)
    stw (r8)                        ; [1]: entry_count == 6
    inc r8
    inc r8
    lm r0, (gsu_runtime_stride_shift)
    stw (r8)                        ; [2]: stride_shift == 6
    inc r8
    inc r8
    lm r0, (MAP_BUF + 6)
    stw (r8)                        ; [3]: prebake tag == $BACE
    inc r8
    inc r8
    lm r0, (MAP_BUF + 8 + (18 * 8) + 6)
    stw (r8)                        ; [4]: cell(2,2) drops == $2020
    inc r8
    inc r8
    lm r0, (gsu_iso_active_arch_mask)
    stw (r8)                        ; [5]: active_arch_mask == $0D05
    iwt r15, #test_done
    nop

; ------------------------------------------------------------------------------
; Case 3: Full Two-Pass Hardware Rasterization (`yaw = 15`) of Studio Assets
; ------------------------------------------------------------------------------
case_3:
    call gsu_iso_import_bank71
    iwt r1, #15
    call render_full_frame_at_yaw r1
    iwt r15, #test_done
    nop

; ------------------------------------------------------------------------------
; Case 4: Rotated Quadrant (`yaw = 75`) Two-Pass Rasterization & RAMBR == 0 Check
; ------------------------------------------------------------------------------
case_4:
    iwt r1, #75
    call render_full_frame_at_yaw r1

    ; Store BANK70_SENTINEL ($BEEF) in slot [6] using current RAMBR (proving RAMBR == 0)
    iwt r1, #BANK70_SENTINEL
    to r4
    ldw (r1)
    iwt r8, #(TEST_RESULT + 12)
    from r4
    stw (r8)

test_done:
    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
test_stop:
    nop
    nop
    gsu_stack_pop r13
    gsu_stack_pop r12
    loop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    stop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
