; ==============================================================================
; TEST_DRAW_TRAP_RAM - GSU Unit Test Suite for Bank-$71 `draw_cached_trap_ram`
; ==============================================================================
.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "../../common/util.i"
.include "../../common/control.i"
.include "libSFX.i"

.segment "GSURAM"
.align 2
TEXTURE_TABLE_RAM:  .res 64
.export TEXTURE_TABLE_RAM
.import PARITY_ROM_TEX
TEST_CASE_IDX:      .res 2
TEST_RESULT:        .res 32
TEST_TRAP:          .res 32
TEST_TRAP_B:        .res 32
SENTINEL_WORD:      .res 2
ROM_SNAP_BUF:       .res 1536

.segment "GSUCODE"
GSU_Entry:
    iwt r15, #GSU_Code
    nop

.include "../../IsoEngine/triangle/cached_trap.i"
.include "../../gsu_iso/bank71_layout.i"
.include "../../gsu_iso/draw_cached_trap.i"
.include "../../gsu_iso/draw_cached_trap_ram.i"

; Helper: clear 4bpp screen buffer at $70:A000..$70:C7FF
function clear_screen_buf
    ibt r0, #0
    ramb
    iwt r1, #$A000
    iwt r12, #($2800 / 2)
    iwt r13, #@clr_loop
    ibt r0, #0
@clr_loop:
    stw (r1)
    inc r1
    loop
    inc r1
    return
endfunction

; Helper: populate axis-aligned rectangle `cached_trap` at TEST_TRAP
; In: r1=count, r2=xL_q88, r3=xR_q88, r4=tex_id (stride_shift=6 -> dv_dy=$0040, du_dx=$0100)
function init_rect_trap count_in, xL_in, xR_in, tex_id_in
    register count_in = r1, xL_in = r2, xR_in = r3, tex_id_in = r4
    iwt r8, #TEST_TRAP
    ibt r0, #0
    stw (r8)                ; +0:  dy_start = 0
    inc r8
    inc r8
    from count_in
    stw (r8)                ; +2:  line_count
    inc r8
    inc r8
    from xL_in
    stw (r8)                ; +4:  xL_start
    inc r8
    inc r8
    from xR_in
    stw (r8)                ; +6:  xR_start
    inc r8
    inc r8
    ibt r0, #0
    stw (r8)                ; +8:  dxL_dy = 0
    inc r8
    inc r8
    stw (r8)                ; +10: dxR_dy = 0
    inc r8
    inc r8
    stw (r8)                ; +12: uL_start = 0
    inc r8
    inc r8
    stw (r8)                ; +14: vL_start = 0
    inc r8
    inc r8
    stw (r8)                ; +16: du_dy = 0
    inc r8
    inc r8
    iwt r0, #(1 << 6)
    stw (r8)                ; +18: dv_dy = 1.0 row in Q10.6
    inc r8
    inc r8
    iwt r0, #$0100
    stw (r8)                ; +20: du_dx = 1.0 col in Q8.8
    inc r8
    inc r8
    ibt r0, #0
    stw (r8)                ; +22: dv_dx = 0
    inc r8
    inc r8
    from tex_id_in
    stw (r8)                ; +24: tex_id
    return
endfunction

.export GSU_Code
GSU_Code:
    init_stack
    ibt r0, #0
    ramb

test_setup:
    iwt r12, #5
    iwt r13, #test_call

test_call:
    gsu_stack_push r12
    gsu_stack_push r13

    lm r9, (TEST_CASE_IDX)

    ; Clear TEST_RESULT (16 words)
    iwt r8, #TEST_RESULT
    iwt r12, #16
    iwt r13, #clear_res_loop
    ibt r0, #0
clear_res_loop:
    stw (r8)
    inc r8
    loop
    inc r8

    ; Write Bank-$70 vs Bank-$71 RAMBR sentinels at identical 16-bit offset
    ibt r0, #0
    ramb
    iwt r1, #SENTINEL_WORD
    iwt r0, #$BEEF
    stw (r1)
    ibt r0, #1
    ramb
    iwt r0, #$CAFE
    stw (r1)
    ibt r0, #0
    ramb

    from r9
    sub #1
    bne @check_2
    nop
    iwt r13, #run_case_1
    jmp r13
    nop
@check_2:
    from r9
    sub #2
    bne @check_3
    nop
    iwt r13, #run_case_2
    jmp r13
    nop
@check_3:
    from r9
    sub #3
    bne @check_4
    nop
    iwt r13, #run_case_3
    jmp r13
    nop
@check_4:
    from r9
    sub #4
    bne @check_5
    nop
    iwt r13, #run_case_4
    jmp r13
    nop
@check_5:
    iwt r13, #run_case_5
    jmp r13
    nop

; ==============================================================================
; Case 1: Bank-$71 Non-Zero `atlas_offset` ($4200), Color-0 Transparency & RAMBR==0
; Also spans > 8 pixels (16 pixels: x=8..23) so plot cache flushes WHILE RAMBR==1!
; ==============================================================================
run_case_1:
    call clear_screen_buf

    ; Stage 8x8 slice at $71:4200 (stride 64):
    ; u=0..3 -> colors 2,3,4,5; u=4..7 -> color 0 (transparent)
    ibt r0, #1
    ramb
    iwt r4, #$4200
    iwt r5, #8
@c1_row_loop:
    move r1, r4
    ibt r0, #2
    stb (r1)
    inc r1
    ibt r0, #3
    stb (r1)
    inc r1
    ibt r0, #4
    stb (r1)
    inc r1
    ibt r0, #5
    stb (r1)
    inc r1
    ibt r0, #0
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    iwt r6, #64
    with r4
    add r6
    dec r5
    bne @c1_row_loop
    nop
    ibt r0, #0
    ramb

    ; Descriptor 0 in Bank-$70 TEXTURE_TABLE_RAM:
    iwt r1, #TEXTURE_TABLE_RAM
    iwt r0, #$4200
    stw (r1)
    inc r1
    inc r1
    iwt r0, #7
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(7 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((7 << 6) | 63)
    stw (r1)

    ; Pre-paint background row y=20, x=8..23 (16 pixels across two 8-px tiles!) with color 9
    ibt r0, #9
    color
    ibt r0, #0
    cmode
    iwt r1, #8
    iwt r2, #20
    iwt r12, #16
    iwt r13, #@c1_bg_loop
@c1_bg_loop:
    loop
    plot
    rpix
    rpix

    ; Build 16-px wide rect trap: count=4, xL=8.0 ($0800), xR=24.0 ($1800), tex_id=0
    iwt r1, #4
    iwt r2, #$0800
    iwt r3, #$1800
    iwt r4, #0
    call init_rect_trap r1, r2, r3, r4

    iwt r1, #TEST_TRAP
    iwt r3, #0
    iwt r4, #20
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; IMMEDIATELY verify RAMBR == 0 WITHOUT touching `ramb`!
    iwt r1, #SENTINEL_WORD
    to r9
    ldw (r1)

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    iwt r8, #TEST_RESULT
    from r9
    stw (r8)                ; [0]: sentinel ($BEEF)
    inc r8
    inc r8

    iwt r1, #8
    iwt r2, #20
    rpix
    stw (r8)                ; [1]: px(8,20) == 2 (flushed mid-span while RAMBR==1!)
    inc r8
    inc r8

    iwt r1, #9
    iwt r2, #20
    rpix
    stw (r8)                ; [2]: px(9,20) == 3
    inc r8
    inc r8

    iwt r1, #12
    iwt r2, #20
    rpix
    stw (r8)                ; [3]: px(12,20) == 9 (transparent texel 0 preserved bg!)
    inc r8
    inc r8

    iwt r1, #16
    iwt r2, #20
    rpix
    stw (r8)                ; [4]: px(16,20) == 2 (second 8-px tile wrap!)
    inc r8
    inc r8

    iwt r1, #19
    iwt r2, #20
    rpix
    stw (r8)                ; [5]: px(19,20) == 5

    iwt r13, #test_done
    jmp r13
    nop

; ==============================================================================
; Case 2: Power-of-Two `u_mask` / `v_mask_shifted` Tiling Wrap Across Offsets
; ==============================================================================
run_case_2:
    call clear_screen_buf

    ; Stage 4x4 2x2-quadrant texture at $71:5000 (stride 64):
    ; rows 0..1: [3,3, 4,4]; rows 2..3: [5,5, 6,6]
    ibt r0, #1
    ramb
    iwt r4, #$5000
    iwt r5, #2
@c2_top_rows:
    move r1, r4
    ibt r0, #3
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    ibt r0, #4
    stb (r1)
    inc r1
    stb (r1)
    iwt r6, #64
    with r4
    add r6
    dec r5
    bne @c2_top_rows
    nop

    iwt r5, #2
@c2_bot_rows:
    move r1, r4
    ibt r0, #5
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    ibt r0, #6
    stb (r1)
    inc r1
    stb (r1)
    iwt r6, #64
    with r4
    add r6
    dec r5
    bne @c2_bot_rows
    nop
    ibt r0, #0
    ramb

    ; Descriptor 1: offset=$5000, u_mask=3, v_mask=(3<<6), v_preserve=(3<<6)|63
    iwt r1, #(TEXTURE_TABLE_RAM + 8)
    iwt r0, #$5000
    stw (r1)
    inc r1
    inc r1
    iwt r0, #3
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(3 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((3 << 6) | 63)
    stw (r1)

    ; 8x8 rect trap (x=[0..8), tex_id=1)
    iwt r1, #8
    iwt r2, #0
    iwt r3, #$0800
    iwt r4, #1
    call init_rect_trap r1, r2, r3, r4

    ; Render at (30, 30) with u_offset = +2.0 ($0200), v_offset = +2 rows (2 << 6)
    iwt r1, #TEST_TRAP
    iwt r3, #30
    iwt r4, #30
    iwt r5, #$0200
    iwt r6, #(2 << 6)
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    iwt r8, #TEST_RESULT
    iwt r1, #30
    iwt r2, #30
    rpix
    stw (r8)                ; [0]: (u=2,v=2) -> 6
    inc r8
    inc r8

    iwt r1, #32
    iwt r2, #30
    rpix
    stw (r8)                ; [1]: (u=4->0,v=2) -> 5
    inc r8
    inc r8

    iwt r1, #30
    iwt r2, #32
    rpix
    stw (r8)                ; [2]: (u=2,v=4->0) -> 4
    inc r8
    inc r8

    iwt r1, #32
    iwt r2, #32
    rpix
    stw (r8)                ; [3]: (u=0,v=0) -> 3

    iwt r13, #test_done
    jmp r13
    nop

; ==============================================================================
; Case 3: Pass 0 [0..127] vs Pass 1 [128..255] Horizontal Seam Clipping
; ==============================================================================
run_case_3:
    call clear_screen_buf

    ; Stage solid color 7 4x4 texture at $71:6000
    ibt r0, #1
    ramb
    iwt r4, #$6000
    iwt r5, #4
@c3_tex_rows:
    move r1, r4
    ibt r0, #7
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    iwt r6, #64
    with r4
    add r6
    dec r5
    bne @c3_tex_rows
    nop
    ibt r0, #0
    ramb

    ; Descriptor 2: offset=$6000, 4x4
    iwt r1, #(TEXTURE_TABLE_RAM + 16)
    iwt r0, #$6000
    stw (r1)
    inc r1
    inc r1
    iwt r0, #3
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(3 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((3 << 6) | 63)
    stw (r1)

    ; 8x4 rect trap (x=[0..8), count=4, tex_id=2), anchored at X=124..132, Y=50
    iwt r1, #4
    iwt r2, #0
    iwt r3, #$0800
    iwt r4, #2
    call init_rect_trap r1, r2, r3, r4

    ; Pass 0 (frame_half = 0)
    iwt r1, #TEST_TRAP
    iwt r3, #124
    iwt r4, #50
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    iwt r8, #TEST_RESULT
    iwt r1, #123
    iwt r2, #50
    rpix
    stw (r8)                ; [0]: px(123,50) == 0
    inc r8
    inc r8
    iwt r1, #124
    iwt r2, #50
    rpix
    stw (r8)                ; [1]: px(124,50) == 7
    inc r8
    inc r8
    iwt r1, #127
    iwt r2, #50
    rpix
    stw (r8)                ; [2]: px(127,50) == 7
    inc r8
    inc r8

    ; Clear buffer and render Pass 1 (frame_half = 1 -> X=128..131 maps to X'=0..3)
    call clear_screen_buf

    iwt r1, #TEST_TRAP
    iwt r3, #124
    iwt r4, #50
    iwt r5, #0
    iwt r6, #0
    iwt r7, #1
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    iwt r8, #(TEST_RESULT + 6)
    iwt r1, #0
    iwt r2, #50
    rpix
    stw (r8)                ; [3]: px'(0,50) == 7
    inc r8
    inc r8
    iwt r1, #3
    iwt r2, #50
    rpix
    stw (r8)                ; [4]: px'(3,50) == 7
    inc r8
    inc r8
    iwt r1, #4
    iwt r2, #50
    rpix
    stw (r8)                ; [5]: px'(4,50) == 0

    iwt r13, #test_done
    jmp r13
    nop

; ==============================================================================
; Case 4: Top/Bottom Vertical Clipping & Off-Screen Early-Exit `RAMBR == 0`
; ==============================================================================
run_case_4:
    call clear_screen_buf

    ibt r0, #1
    ramb
    iwt r4, #$6000
    iwt r5, #4
@c4_tex_rows:
    move r1, r4
    ibt r0, #7
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    iwt r6, #64
    with r4
    add r6
    dec r5
    bne @c4_tex_rows
    nop
    ibt r0, #0
    ramb

    iwt r1, #(TEXTURE_TABLE_RAM + 16)
    iwt r0, #$6000
    stw (r1)
    inc r1
    inc r1
    iwt r0, #3
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(3 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((3 << 6) | 63)
    stw (r1)

    ; 4x5 rect trap (count=5, x=[0..4), tex_id=2)
    iwt r1, #5
    iwt r2, #0
    iwt r3, #$0400
    iwt r4, #2
    call init_rect_trap r1, r2, r3, r4

    ; 1) Top-clipped: anchor_x=40, anchor_y=-2 ($FFFE) -> draws Y=0..2
    iwt r1, #TEST_TRAP
    iwt r3, #40
    iwt r4, #$FFFE
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; 2) Completely above screen (anchor_y = -10) -> early exit
    iwt r1, #TEST_TRAP
    iwt r3, #40
    iwt r4, #$FFF6
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; 3) Completely below screen (anchor_y = 165) -> early exit
    iwt r1, #TEST_TRAP
    iwt r3, #40
    iwt r4, #165
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; 4) Completely right of Pass 0 (anchor_x = 200) -> early exit
    iwt r1, #TEST_TRAP
    iwt r3, #200
    iwt r4, #40
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; Check RAMBR == 0 sentinel after early exits
    iwt r1, #SENTINEL_WORD
    to r9
    ldw (r1)

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    iwt r8, #TEST_RESULT
    from r9
    stw (r8)                ; [0]: sentinel ($BEEF)
    inc r8
    inc r8
    iwt r1, #40
    iwt r2, #0
    rpix
    stw (r8)                ; [1]: px(40,0) == 7
    inc r8
    inc r8
    iwt r1, #40
    iwt r2, #2
    rpix
    stw (r8)                ; [2]: px(40,2) == 7
    inc r8
    inc r8
    iwt r1, #40
    iwt r2, #3
    rpix
    stw (r8)                ; [3]: px(40,3) == 0

    iwt r13, #test_done
    jmp r13
    nop

; ==============================================================================
; Case 5: Bit-Exact Pixel Parity Between ROM `draw_cached_trap` and Bank-$71
;         `draw_cached_trap_ram` Across Top-Clipped (`@skip_loop`) and
;         Left-Clipped (`@clip_u_loop`) Skewed Affine Trapezoids + `RAMBR == 0`
; ==============================================================================
; Helper: clear screen buffer and paint background color 11 on x=0..15, y=0..23
; so color-0 transparent cutout preservation is tested alongside opaque texels.
function prep_parity_scene
    call clear_screen_buf
    ibt r0, #11
    color
    ibt r0, #0
    cmode
    ibt r2, #0              ; y = 0..23
    iwt r5, #24
@bg_y_loop:
    ibt r1, #0              ; x = 0..15
    iwt r12, #16
    iwt r13, #@bg_x_loop
@bg_x_loop:
    loop
    plot
    inc r2
    dec r5
    bne @bg_y_loop
    nop
    rpix
    rpix
    return
endfunction

run_case_5:
    ; Stage exact 1,024-byte copy of PARITY_ROM_TEX from ROM Bank $04 into $71:3400
    ibt r0, #1
    ramb
    rom_to_ram #PARITY_ROM_TEX, #$04, #$3400, #1024
    ibt r0, #0
    ramb
    ibt r0, #$04
    romb

    ; Descriptor 3 (ROM `draw_cached_trap`): offset = .loword(PARITY_ROM_TEX), 16x16 pitch 64
    iwt r1, #(TEXTURE_TABLE_RAM + 24)
    iwt r0, #.loword(PARITY_ROM_TEX)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #15
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(15 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((15 << 6) | 63)
    stw (r1)

    ; Descriptor 4 (Bank-$71 `draw_cached_trap_ram`): offset = $3400, 16x16 pitch 64
    iwt r1, #(TEXTURE_TABLE_RAM + 32)
    iwt r0, #$3400
    stw (r1)
    inc r1
    inc r1
    iwt r0, #15
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(15 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((15 << 6) | 63)
    stw (r1)

    ; Populate Trap A (TEST_TRAP): Top-Clipped skewed affine trapezoid (anchor_y = -5 -> @skip_loop)
    iwt r8, #TEST_TRAP
    ibt r0, #0
    stw (r8)                ; +0:  dy_start = 0
    inc r8
    inc r8
    iwt r0, #13
    stw (r8)                ; +2:  line_count = 13 (5 clipped, 8 drawn at y=0..7)
    inc r8
    inc r8
    iwt r0, #$0240
    stw (r8)                ; +4:  xL_start = 2.25
    inc r8
    inc r8
    iwt r0, #$1080
    stw (r8)                ; +6:  xR_start = 16.5
    inc r8
    inc r8
    iwt r0, #$0050
    stw (r8)                ; +8:  dxL_dy = +0.3125
    inc r8
    inc r8
    iwt r0, #$0090
    stw (r8)                ; +10: dxR_dy = +0.5625
    inc r8
    inc r8
    iwt r0, #$0140
    stw (r8)                ; +12: uL_start
    inc r8
    inc r8
    iwt r0, #$0030
    stw (r8)                ; +14: vL_start
    inc r8
    inc r8
    iwt r0, #$0070
    stw (r8)                ; +16: du_dy
    inc r8
    inc r8
    iwt r0, #$0054
    stw (r8)                ; +18: dv_dy
    inc r8
    inc r8
    iwt r0, #$0130
    stw (r8)                ; +20: du_dx
    inc r8
    inc r8
    iwt r0, #$0028
    stw (r8)                ; +22: dv_dx
    inc r8
    inc r8
    ibt r0, #3
    stw (r8)                ; +24: tex_id = 3 (ROM)

    ; Populate Trap B (TEST_TRAP_B): Left-Clipped skewed affine trapezoid (anchor_x = -8 -> @clip_u_loop)
    iwt r8, #TEST_TRAP_B
    ibt r0, #0
    stw (r8)                ; +0:  dy_start = 0
    inc r8
    inc r8
    iwt r0, #10
    stw (r8)                ; +2:  line_count = 10 (drawn at y=10..19)
    inc r8
    inc r8
    iwt r0, #$0200
    stw (r8)                ; +4:  xL_start = 2.0 (with anchor_x=-8 -> -6.0!)
    inc r8
    inc r8
    iwt r0, #$1380
    stw (r8)                ; +6:  xR_start = 19.5 (with anchor_x=-8 -> 11.5)
    inc r8
    inc r8
    iwt r0, #$FFE0
    stw (r8)                ; +8:  dxL_dy = -0.125
    inc r8
    inc r8
    iwt r0, #$0060
    stw (r8)                ; +10: dxR_dy = +0.375
    inc r8
    inc r8
    iwt r0, #$00C0
    stw (r8)                ; +12: uL_start
    inc r8
    inc r8
    iwt r0, #$0020
    stw (r8)                ; +14: vL_start
    inc r8
    inc r8
    iwt r0, #$0068
    stw (r8)                ; +16: du_dy
    inc r8
    inc r8
    iwt r0, #$0048
    stw (r8)                ; +18: dv_dy
    inc r8
    inc r8
    iwt r0, #$0148
    stw (r8)                ; +20: du_dx
    inc r8
    inc r8
    iwt r0, #$0034
    stw (r8)                ; +22: dv_dx
    inc r8
    inc r8
    ibt r0, #3
    stw (r8)                ; +24: tex_id = 3 (ROM)

    ; --- 1. Render Trap A + Trap B via ROM `draw_cached_trap` ---
    call prep_parity_scene
    ibt r0, #$04
    romb

    iwt r1, #TEST_TRAP
    iwt r3, #4              ; anchor_x = 4
    iwt r4, #$FFFB          ; anchor_y = -5 (top-clipped!)
    iwt r5, #$0280          ; u_offset
    iwt r6, #$00C0          ; v_offset
    iwt r7, #0              ; frame_half = 0
    call draw_cached_trap r1, r3, r4, r5, r6, r7

    iwt r1, #TEST_TRAP_B
    iwt r3, #$FFF8          ; anchor_x = -8 (left-clipped!)
    iwt r4, #10             ; anchor_y = 10
    iwt r5, #$0180          ; u_offset
    iwt r6, #$0140          ; v_offset
    iwt r7, #0              ; frame_half = 0
    call draw_cached_trap r1, r3, r4, r5, r6, r7

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    ; Snapshot all 32x24 = 768 pixels into ROM_SNAP_BUF, count non-bg/non-zero & rolling hash
    iwt r8, #ROM_SNAP_BUF
    iwt r6, #0              ; rom_nonzero_count
    iwt r7, #0              ; rom_hash
    ibt r2, #0              ; y = 0..23
@snap_y_loop:
    ibt r1, #0              ; x = 0..31
@snap_x_loop:
    rpix                    ; r0 = pixel(x, y), also clobbers flags
    stw (r8)
    inc r8
    inc r8
    moves r4, r0
    beq @snap_zero
    nop
    inc r6
@snap_zero:
    ; rom_hash = (rom_hash * 3) + px + 1
    from r7
    to r5
    add r7
    with r7
    add r5
    with r7
    add r4
    inc r7

    inc r1
    iwt r0, #32
    from r1
    sub r0
    blt @snap_x_loop
    nop

    inc r2
    iwt r0, #24
    from r2
    sub r0
    blt @snap_y_loop
    nop

    ; Save rom_nonzero_count and rom_hash into TEST_RESULT + 6 and + 8
    iwt r9, #(TEST_RESULT + 6)
    from r6
    stw (r9)
    inc r9
    inc r9
    from r7
    stw (r9)

    ; --- 2. Render identical Trap A + Trap B via Bank-$71 `draw_cached_trap_ram` ---
    call prep_parity_scene

    ; Switch both traps to tex_id = 4 (Bank-$71 copy at $71:3400)
    iwt r8, #(TEST_TRAP + 24)
    ibt r0, #4
    stw (r8)
    iwt r8, #(TEST_TRAP_B + 24)
    ibt r0, #4
    stw (r8)

    iwt r1, #TEST_TRAP
    iwt r3, #4
    iwt r4, #$FFFB
    iwt r5, #$0280
    iwt r6, #$00C0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; IMMEDIATELY verify RAMBR == 0 after Trap A (without touching `ramb`)!
    iwt r1, #SENTINEL_WORD
    to r9
    ldw (r1)
    iwt r8, #TEST_RESULT
    from r9
    stw (r8)                ; [0]: sentinel_a ($BEEF)

    iwt r1, #TEST_TRAP_B
    iwt r3, #$FFF8
    iwt r4, #10
    iwt r5, #$0180
    iwt r6, #$0140
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; IMMEDIATELY verify RAMBR == 0 after Trap B (without touching `ramb`)!
    iwt r1, #SENTINEL_WORD
    to r9
    ldw (r1)
    iwt r8, #(TEST_RESULT + 2)
    from r9
    stw (r8)                ; [2]: sentinel_b ($BEEF)

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    ; Compare all 768 pixels against ROM_SNAP_BUF and compute ram_hash
    iwt r8, #ROM_SNAP_BUF
    iwt r6, #0              ; mismatch_count
    iwt r7, #0              ; ram_hash
    ibt r2, #0              ; y = 0..23
@cmp_y_loop:
    ibt r1, #0              ; x = 0..31
@cmp_x_loop:
    rpix
    move r4, r0             ; r4 = ram_px(x, y)
    ldw (r8)                ; r0 = rom_px(x, y)
    inc r8
    inc r8
    from r4
    sub r0
    beq @px_match
    nop
    inc r6                  ; mismatch_count++
@px_match:
    from r7
    to r5
    add r7
    with r7
    add r5
    with r7
    add r4
    inc r7

    inc r1
    iwt r0, #32
    from r1
    sub r0
    blt @cmp_x_loop
    nop

    inc r2
    iwt r0, #24
    from r2
    sub r0
    blt @cmp_y_loop
    nop

    iwt r9, #(TEST_RESULT + 4)
    from r6
    stw (r9)                ; [4]: mismatch_count (expected 0!)
    iwt r9, #(TEST_RESULT + 10)
    from r7
    stw (r9)                ; [10]: ram_hash (expected == rom_hash!)

test_done:
    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
test_stop:
    nop
    nop
    gsu_stack_pop r13
    gsu_stack_pop r12
    loop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    stop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
