; ==============================================================================
; TEST_DRAW_TRAP_RAM - GSU Unit Test Suite for Bank-$71 `draw_cached_trap_ram`
; ==============================================================================
.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "../../common/util.i"
.include "../../common/control.i"
.include "libSFX.i"

.segment "GSURAM"
.align 2
TEXTURE_TABLE_RAM:  .res 64
.export TEXTURE_TABLE_RAM
TEST_CASE_IDX:      .res 2
TEST_RESULT:        .res 32
TEST_TRAP:          .res 32
SENTINEL_WORD:      .res 2

.segment "GSUCODE"
GSU_Entry:
    iwt r15, #GSU_Code
    nop

.include "../../IsoEngine/triangle/cached_trap.i"
.include "../../gsu_iso/bank71_layout.i"
.include "../../gsu_iso/draw_cached_trap_ram.i"

; Helper: clear 4bpp screen buffer at $70:A000..$70:C7FF
function clear_screen_buf
    ibt r0, #0
    ramb
    iwt r1, #$A000
    iwt r12, #($2800 / 2)
    iwt r13, #@clr_loop
    ibt r0, #0
@clr_loop:
    stw (r1)
    inc r1
    loop
    inc r1
    return
endfunction

; Helper: populate axis-aligned rectangle `cached_trap` at TEST_TRAP
; In: r1=count, r2=xL_q88, r3=xR_q88, r4=tex_id (stride_shift=6 -> dv_dy=$0040, du_dx=$0100)
function init_rect_trap count_in, xL_in, xR_in, tex_id_in
    register count_in = r1, xL_in = r2, xR_in = r3, tex_id_in = r4
    iwt r8, #TEST_TRAP
    ibt r0, #0
    stw (r8)                ; +0:  dy_start = 0
    inc r8
    inc r8
    from count_in
    stw (r8)                ; +2:  line_count
    inc r8
    inc r8
    from xL_in
    stw (r8)                ; +4:  xL_start
    inc r8
    inc r8
    from xR_in
    stw (r8)                ; +6:  xR_start
    inc r8
    inc r8
    ibt r0, #0
    stw (r8)                ; +8:  dxL_dy = 0
    inc r8
    inc r8
    stw (r8)                ; +10: dxR_dy = 0
    inc r8
    inc r8
    stw (r8)                ; +12: uL_start = 0
    inc r8
    inc r8
    stw (r8)                ; +14: vL_start = 0
    inc r8
    inc r8
    stw (r8)                ; +16: du_dy = 0
    inc r8
    inc r8
    iwt r0, #(1 << 6)
    stw (r8)                ; +18: dv_dy = 1.0 row in Q10.6
    inc r8
    inc r8
    iwt r0, #$0100
    stw (r8)                ; +20: du_dx = 1.0 col in Q8.8
    inc r8
    inc r8
    ibt r0, #0
    stw (r8)                ; +22: dv_dx = 0
    inc r8
    inc r8
    from tex_id_in
    stw (r8)                ; +24: tex_id
    return
endfunction

.export GSU_Code
GSU_Code:
    init_stack
    ibt r0, #0
    ramb

test_setup:
    iwt r12, #4
    iwt r13, #test_call

test_call:
    gsu_stack_push r12
    gsu_stack_push r13

    lm r9, (TEST_CASE_IDX)

    ; Clear TEST_RESULT (16 words)
    iwt r8, #TEST_RESULT
    iwt r12, #16
    iwt r13, #clear_res_loop
    ibt r0, #0
clear_res_loop:
    stw (r8)
    inc r8
    loop
    inc r8

    ; Write Bank-$70 vs Bank-$71 RAMBR sentinels at identical 16-bit offset
    ibt r0, #0
    ramb
    iwt r1, #SENTINEL_WORD
    iwt r0, #$BEEF
    stw (r1)
    ibt r0, #1
    ramb
    iwt r0, #$CAFE
    stw (r1)
    ibt r0, #0
    ramb

    from r9
    sub #1
    bne @check_2
    nop
    iwt r13, #run_case_1
    jmp r13
    nop
@check_2:
    from r9
    sub #2
    bne @check_3
    nop
    iwt r13, #run_case_2
    jmp r13
    nop
@check_3:
    from r9
    sub #3
    bne @check_4
    nop
    iwt r13, #run_case_3
    jmp r13
    nop
@check_4:
    iwt r13, #run_case_4
    jmp r13
    nop

; ==============================================================================
; Case 1: Bank-$71 Non-Zero `atlas_offset` ($4200), Color-0 Transparency & RAMBR==0
; Also spans > 8 pixels (16 pixels: x=8..23) so plot cache flushes WHILE RAMBR==1!
; ==============================================================================
run_case_1:
    call clear_screen_buf

    ; Stage 8x8 slice at $71:4200 (stride 64):
    ; u=0..3 -> colors 2,3,4,5; u=4..7 -> color 0 (transparent)
    ibt r0, #1
    ramb
    iwt r4, #$4200
    iwt r5, #8
@c1_row_loop:
    move r1, r4
    ibt r0, #2
    stb (r1)
    inc r1
    ibt r0, #3
    stb (r1)
    inc r1
    ibt r0, #4
    stb (r1)
    inc r1
    ibt r0, #5
    stb (r1)
    inc r1
    ibt r0, #0
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    iwt r6, #64
    with r4
    add r6
    dec r5
    bne @c1_row_loop
    nop
    ibt r0, #0
    ramb

    ; Descriptor 0 in Bank-$70 TEXTURE_TABLE_RAM:
    iwt r1, #TEXTURE_TABLE_RAM
    iwt r0, #$4200
    stw (r1)
    inc r1
    inc r1
    iwt r0, #7
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(7 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((7 << 6) | 63)
    stw (r1)

    ; Pre-paint background row y=20, x=8..23 (16 pixels across two 8-px tiles!) with color 9
    ibt r0, #9
    color
    ibt r0, #0
    cmode
    iwt r1, #8
    iwt r2, #20
    iwt r12, #16
    iwt r13, #@c1_bg_loop
@c1_bg_loop:
    loop
    plot
    rpix
    rpix

    ; Build 16-px wide rect trap: count=4, xL=8.0 ($0800), xR=24.0 ($1800), tex_id=0
    iwt r1, #4
    iwt r2, #$0800
    iwt r3, #$1800
    iwt r4, #0
    call init_rect_trap r1, r2, r3, r4

    iwt r1, #TEST_TRAP
    iwt r3, #0
    iwt r4, #20
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; IMMEDIATELY verify RAMBR == 0 WITHOUT touching `ramb`!
    iwt r1, #SENTINEL_WORD
    to r9
    ldw (r1)

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    iwt r8, #TEST_RESULT
    from r9
    stw (r8)                ; [0]: sentinel ($BEEF)
    inc r8
    inc r8

    iwt r1, #8
    iwt r2, #20
    rpix
    stw (r8)                ; [1]: px(8,20) == 2 (flushed mid-span while RAMBR==1!)
    inc r8
    inc r8

    iwt r1, #9
    iwt r2, #20
    rpix
    stw (r8)                ; [2]: px(9,20) == 3
    inc r8
    inc r8

    iwt r1, #12
    iwt r2, #20
    rpix
    stw (r8)                ; [3]: px(12,20) == 9 (transparent texel 0 preserved bg!)
    inc r8
    inc r8

    iwt r1, #16
    iwt r2, #20
    rpix
    stw (r8)                ; [4]: px(16,20) == 2 (second 8-px tile wrap!)
    inc r8
    inc r8

    iwt r1, #19
    iwt r2, #20
    rpix
    stw (r8)                ; [5]: px(19,20) == 5

    iwt r13, #test_done
    jmp r13
    nop

; ==============================================================================
; Case 2: Power-of-Two `u_mask` / `v_mask_shifted` Tiling Wrap Across Offsets
; ==============================================================================
run_case_2:
    call clear_screen_buf

    ; Stage 4x4 2x2-quadrant texture at $71:5000 (stride 64):
    ; rows 0..1: [3,3, 4,4]; rows 2..3: [5,5, 6,6]
    ibt r0, #1
    ramb
    iwt r4, #$5000
    iwt r5, #2
@c2_top_rows:
    move r1, r4
    ibt r0, #3
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    ibt r0, #4
    stb (r1)
    inc r1
    stb (r1)
    iwt r6, #64
    with r4
    add r6
    dec r5
    bne @c2_top_rows
    nop

    iwt r5, #2
@c2_bot_rows:
    move r1, r4
    ibt r0, #5
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    ibt r0, #6
    stb (r1)
    inc r1
    stb (r1)
    iwt r6, #64
    with r4
    add r6
    dec r5
    bne @c2_bot_rows
    nop
    ibt r0, #0
    ramb

    ; Descriptor 1: offset=$5000, u_mask=3, v_mask=(3<<6), v_preserve=(3<<6)|63
    iwt r1, #(TEXTURE_TABLE_RAM + 8)
    iwt r0, #$5000
    stw (r1)
    inc r1
    inc r1
    iwt r0, #3
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(3 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((3 << 6) | 63)
    stw (r1)

    ; 8x8 rect trap (x=[0..8), tex_id=1)
    iwt r1, #8
    iwt r2, #0
    iwt r3, #$0800
    iwt r4, #1
    call init_rect_trap r1, r2, r3, r4

    ; Render at (30, 30) with u_offset = +2.0 ($0200), v_offset = +2 rows (2 << 6)
    iwt r1, #TEST_TRAP
    iwt r3, #30
    iwt r4, #30
    iwt r5, #$0200
    iwt r6, #(2 << 6)
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    iwt r8, #TEST_RESULT
    iwt r1, #30
    iwt r2, #30
    rpix
    stw (r8)                ; [0]: (u=2,v=2) -> 6
    inc r8
    inc r8

    iwt r1, #32
    iwt r2, #30
    rpix
    stw (r8)                ; [1]: (u=4->0,v=2) -> 5
    inc r8
    inc r8

    iwt r1, #30
    iwt r2, #32
    rpix
    stw (r8)                ; [2]: (u=2,v=4->0) -> 4
    inc r8
    inc r8

    iwt r1, #32
    iwt r2, #32
    rpix
    stw (r8)                ; [3]: (u=0,v=0) -> 3

    iwt r13, #test_done
    jmp r13
    nop

; ==============================================================================
; Case 3: Pass 0 [0..127] vs Pass 1 [128..255] Horizontal Seam Clipping
; ==============================================================================
run_case_3:
    call clear_screen_buf

    ; Stage solid color 7 4x4 texture at $71:6000
    ibt r0, #1
    ramb
    iwt r4, #$6000
    iwt r5, #4
@c3_tex_rows:
    move r1, r4
    ibt r0, #7
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    iwt r6, #64
    with r4
    add r6
    dec r5
    bne @c3_tex_rows
    nop
    ibt r0, #0
    ramb

    ; Descriptor 2: offset=$6000, 4x4
    iwt r1, #(TEXTURE_TABLE_RAM + 16)
    iwt r0, #$6000
    stw (r1)
    inc r1
    inc r1
    iwt r0, #3
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(3 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((3 << 6) | 63)
    stw (r1)

    ; 8x4 rect trap (x=[0..8), count=4, tex_id=2), anchored at X=124..132, Y=50
    iwt r1, #4
    iwt r2, #0
    iwt r3, #$0800
    iwt r4, #2
    call init_rect_trap r1, r2, r3, r4

    ; Pass 0 (frame_half = 0)
    iwt r1, #TEST_TRAP
    iwt r3, #124
    iwt r4, #50
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    iwt r8, #TEST_RESULT
    iwt r1, #123
    iwt r2, #50
    rpix
    stw (r8)                ; [0]: px(123,50) == 0
    inc r8
    inc r8
    iwt r1, #124
    iwt r2, #50
    rpix
    stw (r8)                ; [1]: px(124,50) == 7
    inc r8
    inc r8
    iwt r1, #127
    iwt r2, #50
    rpix
    stw (r8)                ; [2]: px(127,50) == 7
    inc r8
    inc r8

    ; Clear buffer and render Pass 1 (frame_half = 1 -> X=128..131 maps to X'=0..3)
    call clear_screen_buf

    iwt r1, #TEST_TRAP
    iwt r3, #124
    iwt r4, #50
    iwt r5, #0
    iwt r6, #0
    iwt r7, #1
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    iwt r8, #(TEST_RESULT + 6)
    iwt r1, #0
    iwt r2, #50
    rpix
    stw (r8)                ; [3]: px'(0,50) == 7
    inc r8
    inc r8
    iwt r1, #3
    iwt r2, #50
    rpix
    stw (r8)                ; [4]: px'(3,50) == 7
    inc r8
    inc r8
    iwt r1, #4
    iwt r2, #50
    rpix
    stw (r8)                ; [5]: px'(4,50) == 0

    iwt r13, #test_done
    jmp r13
    nop

; ==============================================================================
; Case 4: Top/Bottom Vertical Clipping & Off-Screen Early-Exit `RAMBR == 0`
; ==============================================================================
run_case_4:
    call clear_screen_buf

    ibt r0, #1
    ramb
    iwt r4, #$6000
    iwt r5, #4
@c4_tex_rows:
    move r1, r4
    ibt r0, #7
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    inc r1
    stb (r1)
    iwt r6, #64
    with r4
    add r6
    dec r5
    bne @c4_tex_rows
    nop
    ibt r0, #0
    ramb

    iwt r1, #(TEXTURE_TABLE_RAM + 16)
    iwt r0, #$6000
    stw (r1)
    inc r1
    inc r1
    iwt r0, #3
    stw (r1)
    inc r1
    inc r1
    iwt r0, #(3 << 6)
    stw (r1)
    inc r1
    inc r1
    iwt r0, #((3 << 6) | 63)
    stw (r1)

    ; 4x5 rect trap (count=5, x=[0..4), tex_id=2)
    iwt r1, #5
    iwt r2, #0
    iwt r3, #$0400
    iwt r4, #2
    call init_rect_trap r1, r2, r3, r4

    ; 1) Top-clipped: anchor_x=40, anchor_y=-2 ($FFFE) -> draws Y=0..2
    iwt r1, #TEST_TRAP
    iwt r3, #40
    iwt r4, #$FFFE
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; 2) Completely above screen (anchor_y = -10) -> early exit
    iwt r1, #TEST_TRAP
    iwt r3, #40
    iwt r4, #$FFF6
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; 3) Completely below screen (anchor_y = 165) -> early exit
    iwt r1, #TEST_TRAP
    iwt r3, #40
    iwt r4, #165
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; 4) Completely right of Pass 0 (anchor_x = 200) -> early exit
    iwt r1, #TEST_TRAP
    iwt r3, #200
    iwt r4, #40
    iwt r5, #0
    iwt r6, #0
    iwt r7, #0
    call draw_cached_trap_ram r1, r3, r4, r5, r6, r7

    ; Check RAMBR == 0 sentinel after early exits
    iwt r1, #SENTINEL_WORD
    to r9
    ldw (r1)

    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop

    iwt r8, #TEST_RESULT
    from r9
    stw (r8)                ; [0]: sentinel ($BEEF)
    inc r8
    inc r8
    iwt r1, #40
    iwt r2, #0
    rpix
    stw (r8)                ; [1]: px(40,0) == 7
    inc r8
    inc r8
    iwt r1, #40
    iwt r2, #2
    rpix
    stw (r8)                ; [2]: px(40,2) == 7
    inc r8
    inc r8
    iwt r1, #40
    iwt r2, #3
    rpix
    stw (r8)                ; [3]: px(40,3) == 0

test_done:
    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
test_stop:
    nop
    nop
    gsu_stack_pop r13
    gsu_stack_pop r12
    loop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    stop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
