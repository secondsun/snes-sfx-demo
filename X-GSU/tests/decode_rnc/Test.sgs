; 16-bit 0.16-fixed point reciprocal
; reciprocal

.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "libSFX.i"



.segment "GSURAM"
;.res 1 ; hack to byte align
INPUT:
.res 2
OUTPUT:
.res 342

.segment "GSUCODE"
GSU_Code:

;Setup stack
init_stack
register data_addr, bank, size_hi, size_lo, out_buf, byte_count

	; data_addr = start of compressed rnc file
	; bank = bank of compressed rnc file
	; size_hi = hiword size of compressed rnc file
	; size_lo = loword size of compressed rnc file
	iwt data_addr, #(.loword(badapple))
	iwt bank, #(.hiword(badapple))
	iwt size_hi, #$0
	iwt size_lo, #$7B
	call initialize_buffer data_addr, bank, size_hi, size_lo

	; data_addr = start of compressed data
	; bank = bank of compressed data
	; out_buf = start of uncompressed data; must be preallocated
	; byte_count = bytes to decompress
	iwt data_addr, #(.loword(badapple))
	iwt bank, #(.hiword(badapple))
	iwt out_buf, #OUTPUT
	iwt byte_count, #$7B
	call decompress data_addr, bank, out_buf, byte_count
	
	nop
	nop
	nop
	nop
	test_stop:
	nop
	stop
	nop


;Code goes in code segment
.include "../../gsu_maths/gsu_sqrt.i"
.include "../../gsu_maths/gsu_vector.i"
.include "../../gsu_maths/gsu_recip.i"
.include "../../gsu_maths/gsu_camera.i"
.include "../../rnc/gsu_decompress.i"
