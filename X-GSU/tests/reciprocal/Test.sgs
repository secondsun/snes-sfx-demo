; SuperFX
; 16-bit 0.16-fixed point reciprocal test

.include "../../common/stack.i"
.include "../../common/function.i"
.include "../../common/structs.i"
.include "../../common/var.i"
.include "../../common/control.i"
.include "libSFX.i"

.segment "GSURAM"
INPUT:
.res 2
OUTPUT:
.res 2

.segment "GSUCODE"
GSU_Code:

; Setup stack
init_stack

test_setup:
	iwt r12, #$400 ; loop 1024 times
	iwt r13, #test_call

test_call:
	gsu_stack_push r12
	gsu_stack_push r13
	lm r0, (INPUT)
	call reciprocal
	sm (OUTPUT), r3
	; LET MEMORY SETTLE
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
test_stop:
	nop
	nop
	gsu_stack_pop r13
	gsu_stack_pop r12
	loop
	nop
	stop
	nop

; Code goes in code segment
.include "../../gsu_maths/gsu_sqrt.i"
.include "../../gsu_maths/gsu_vector.i"
.include "../../gsu_maths/gsu_recip.i"
.include "../../gsu_maths/gsu_camera.i"
