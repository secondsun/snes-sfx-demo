; ==============================================================================
; SuperFX.sgs - Bank-$71 Isometric Level Showcase GSU Program (RamMapDemo)
;
; Imports relocatable `.tab` + `.map` staged in Game Pak RAM Bank $71 whenever
; `GSU_INIT_FLAG == 0`, compiles rotated archetype trapezoids into Bank $70,
; and renders two 128x160 4bpp half-screen passes per frame while fetching
; texels from Bank $71 (`draw_cached_trap_ram`).
; ==============================================================================
.debuginfo +
.include "../gsu_mesh/gsu_mesh.i"

.segment "GSUCODE"
GSU_Code:
.export GSU_Code

    init_stack
    register fb_ptr, cam_ptr, basis_ptr, lat_ptr, arch_ptr, yaw_ptr, map_ptr, frame_half, debug_ptr, tmp

    ; Ensure ROMBR = $04 (trig/reciprocal LUTs) and RAMBR = 0 ($70 working RAM)
    ibt r0, #$04
    romb
    ibt r0, #0
    ramb

    ; Clear 10 KB half-screen buffer at $70:8000 ($1400 words)
    iwt r0, #0
    cmode
    iwt fb_ptr, #$8000
    iwt r12, #$1400
    cache
    move r13, r15
        stw (fb_ptr)
        inc fb_ptr
        loop
        inc fb_ptr
    nop

    ; Enable 4bpp transparency (color 0 transparent)
    iwt r0, #$08
    cmode

    ; Dispatch Hybrid 3D Mesh engine (GSU_SCENE_MODE != 0) vs Block MapGrid (== 0)
    lm tmp, (GSU_SCENE_MODE)
    moves tmp, tmp
    bne @mesh_mode
    nop
    iwt r15, #@iso_mode
    nop

@mesh_mode:
    lm tmp, (GSU_INIT_FLAG)
    moves tmp, tmp
    bne @mesh_ready
    nop
    call gsu_mesh_import_bank71
@mesh_ready:
    iwt tmp, #GSU_FRAME_HALF
    ldb (tmp)
    lob
    moves r0, r0
    beq @mesh_pass0
    nop
    iwt r1, #1
    call gsu_mesh_render_pass
    iwt r15, #finish_pass
    nop
@mesh_pass0:
    lm tmp, (GSU_JOYPAD)
    iwt cam_ptr, #ISO_CAM
    call iso_camera_update_controls cam_ptr, tmp
    call gsu_mesh_build_scene
    iwt r1, #0
    call gsu_mesh_render_pass
    iwt r15, #finish_pass
    nop

@iso_mode:
    ; Import Bank-$71 `.tab` + `.map` if the 65816 host staged a new level/map
    lm tmp, (GSU_INIT_FLAG)
    moves tmp, tmp
    bne @scene_ready
    nop
    call gsu_iso_import_bank71

    ; Auto-frame ISO_CAM::center_y (+8) to `GSU_ISO_CENTER_Y + 4 * max(base_height)`
    ; so tall FFT stages (Orbonne +12h, Riovanes +12h, Bervenia +9h) fit on boot.
    ibt r0, #0
    ramb
    iwt r1, #MAP_BUF
    ldb (r1)
    lob
    move r6, r0             ; r6 = cols (R1..R15 required for umult Rn)
    inc r1
    ldb (r1)
    lob
    umult r6                ; r0 = rows * cols (16..256)
    move r12, r0
    iwt r1, #(MAP_BUF + 8)  ; cell[0].base_height (+0)
    ibt r2, #0              ; r2 = max_bh
    move r13, r15
        ldb (r1)
        lob
        move r3, r0         ; r3 = cell.base_height
        from r2
        cmp r3
        bge @keep_max_bh
        nop
        move r2, r3
@keep_max_bh:
        with r1
        add #8
        loop
        nop
    with r2
    add r2
    with r2
    add r2                  ; r2 = 4 * max_bh
    iwt r0, #GSU_ISO_CENTER_Y
    add r2
    iwt r1, #(ISO_CAM + 8)
    stw (r1)

    ; On full level load (SFX_LOAD_MODE_LEVEL), start at classic 45-deg diamond yaw=15
    lm tmp, (GSU_LOAD_MODE)
    from tmp
    sub #SFX_LOAD_MODE_LEVEL
    bne @scene_ready
    nop
    iwt cam_ptr, #ISO_CAM
    iwt tmp, #15
    call iso_camera_set_yaw cam_ptr, tmp
@scene_ready:

    ; Check GSU_FRAME_HALF (0 = left half [0..127], 1 = right half [128..255])
    iwt tmp, #GSU_FRAME_HALF
    ldb (tmp)
    lob
    moves r0, r0
    beq @do_pass0
    nop
    iwt r15, #do_pass1
    nop

@do_pass0:
    ; Pass 0: Apply L/R yaw orbit & D-Pad pan from joypad
    lm tmp, (GSU_JOYPAD)
    iwt cam_ptr, #ISO_CAM
    call iso_camera_update_controls cam_ptr, tmp

    ; Recompile rotated archetype trapezoids when yaw changes
    iwt r1, #ISO_CAM
    iwt r2, #ISO_BASIS
    iwt r3, #LATTICE_V2
    iwt r4, #ARCH_TRAPS
    iwt r5, #CACHED_YAW
    call gsu_iso_compile_archetypes r1, r2, r3, r4, r5

    ; Re-center grid origin (cols/2, rows/2) around camera focus (center_x, center_y)
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    call gsu_iso_update_origin r1, r2

    ; Render Pass 0 (left half X in 0..127)
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #0
    iwt r6, #0
    call gsu_iso_render r1, r2, r3, r4, r5, r6
    bra finish_pass
    nop

do_pass1:
    ; Render Pass 1 (right half X in 128..255) using cached archetypes & origin
    iwt r1, #MAP_BUF
    iwt r2, #ISO_CAM
    iwt r3, #ISO_BASIS
    iwt r4, #ARCH_TRAPS
    iwt r5, #1
    iwt r6, #0
    call gsu_iso_render r1, r2, r3, r4, r5, r6

finish_pass:
    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    stop
    nop
    nop
    nop
