.debuginfo +
.include "libSFX.i"
.include "../common/stack.i"
.include "../common/function.i"
.include "../common/control.i"
.include "../common/structs.i"
.include "../common/var.i"
.include "../common/util.i"

.include "Data/TEXTURES.i"
GSU_ISO_USE_ROM_TEXTURES = 1
GSU_ISO_MAX_TAB_BYTES    = TEXTURE_TABLE_SIZE_BYTES
GSU_ISO_MAX_MAP_BYTES    = 8 + (12 * 8 * 8)
.include "../gsu_iso/gsu_iso_map.i"
.include "Data/starship_map.i"

.segment "GSUCODE"
GSU_Code:
.export GSU_Code

    init_stack
    register fb_ptr, cam_ptr, basis_ptr, lat_ptr, arch_ptr, yaw_ptr, map_ptr, frame_half, debug_ptr, tmp

resetFrameBuffer:
    ibt r0, #0
    ramb
    cmode
    iwt fb_ptr, #$4000
    iwt r12, #$1400
    cache
    move r13, r15
        stw (fb_ptr)
        inc fb_ptr
        loop
        inc fb_ptr
    nop

init_gsu_main:
    ; Ensure ROMBR = $04 (GSUDATA LUTs + textures_binary)
    ibt r0, #$04
    romb

    ; One-time scene initialization check
    lm tmp, (GSU_INIT_FLAG)
    moves tmp, tmp
    bne scene_initialized
    nop
    iwt r1, #STARSHIP_MAP_ROM
    iwt r2, #MAP_BYTE_SIZE
    iwt r3, #TEXTURE_TABLE
    iwt r4, #TEXTURE_TABLE_SIZE_BYTES
    iwt r5, #ATLAS_STRIDE_SHIFT
    call gsu_iso_init_rom r1, r2, r3, r4, r5
scene_initialized:

    ; Check GSU_FRAME_HALF:
    ; Pass 0 (left half, X in 0..127): update camera controls, compile archetypes if yaw is dirty, render left half
    ; Pass 1 (right half, X in 128..255): render right half using cached archetypes
    iwt tmp, #GSU_FRAME_HALF
    ldb (tmp)
    lob
    moves r0, r0
    beq @do_pass0
    nop
    iwt r15, #do_pass1
    nop
@do_pass0:

    ; --- Pass 0: Update camera yaw (L/R) and translation (D-pad) from controller ---
    lm tmp, (GSU_JOYPAD)
    iwt cam_ptr, #ISO_CAM
    call iso_camera_update_controls cam_ptr, tmp

    ; Compile shape archetypes if camera yaw changed
    iwt cam_ptr, #ISO_CAM
    iwt basis_ptr, #ISO_BASIS
    iwt lat_ptr, #LATTICE_V2
    iwt arch_ptr, #ARCH_TRAPS
    iwt yaw_ptr, #CACHED_YAW
    call gsu_iso_compile_archetypes cam_ptr, basis_ptr, lat_ptr, arch_ptr, yaw_ptr

    ; Update centered screen-space grid origin from camera focus
    iwt map_ptr, #MAP_BUF
    iwt cam_ptr, #ISO_CAM
    call gsu_iso_update_origin map_ptr, cam_ptr

    ; Render Pass 0 (frame_half = 0)
    iwt map_ptr, #MAP_BUF
    iwt cam_ptr, #ISO_CAM
    iwt basis_ptr, #ISO_BASIS
    iwt arch_ptr, #ARCH_TRAPS
    iwt frame_half, #0
    iwt debug_ptr, #0
    call gsu_iso_render map_ptr, cam_ptr, basis_ptr, arch_ptr, frame_half, debug_ptr
    bra finish
    nop

do_pass1:
    ; Render Pass 1 (frame_half = 1)
    iwt map_ptr, #MAP_BUF
    iwt cam_ptr, #ISO_CAM
    iwt basis_ptr, #ISO_BASIS
    iwt arch_ptr, #ARCH_TRAPS
    iwt frame_half, #1
    iwt debug_ptr, #0
    call gsu_iso_render map_ptr, cam_ptr, basis_ptr, arch_ptr, frame_half, debug_ptr

finish:
shutdown:
    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    stop
    nop
    nop
    nop
