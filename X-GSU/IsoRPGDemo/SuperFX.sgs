; ==============================================================================
; SuperFX.sgs - IsoRPGDemo Pure-Renderer SuperFX GSU Program (ADR 0006)
;
; Renders the 192x160 4bpp isometric viewport driven strictly by the 65816-owned
; `GSU_SCENE_DESC` (`gsu_scene_descriptor`) in Bank $70 GSURAM:
;   - Pass 0 (`GSU_FRAME_HALF == 0`): X in [0..127]  ($2800 bytes at $70:8000)
;   - Pass 1 (`GSU_FRAME_HALF == 1`): X in [128..191] ($1400 bytes at $70:8000)
; Never polls `GSU_JOYPAD` or modifies camera controls.
; ==============================================================================
.debuginfo +

GSU_ISO_VIEWPORT_W           = 192
GSU_ISO_USE_SCENE_DESCRIPTOR = 1

.include "../gsu_mesh/gsu_mesh.i"

.segment "GSUCODE"
GSU_Code:
.export GSU_Code

    init_stack
    register fb_ptr, frame_half, tmp

    ; Ensure ROMBR = $04 (trig/reciprocal LUTs) and RAMBR = 0 ($70 working RAM)
    ibt r0, #$04
    romb
    ibt r0, #0
    ramb

    ; Read active frame half (0 = Pass 0 128x160, 1 = Pass 1 64x160)
    iwt tmp, #GSU_FRAME_HALF
    ldb (tmp)
    lob
    move frame_half, r0

    ; Clear active half-screen buffer at $70:8000
    ; Pass 0 = $1400 words ($2800 B), Pass 1 = $0A00 words ($1400 B)
    iwt r0, #0
    cmode
    iwt fb_ptr, #$8000
    moves frame_half, frame_half
    bne @clear_pass1
    nop
    iwt r12, #$1400
    bra @do_clear
    nop
@clear_pass1:
    iwt r12, #$0A00
@do_clear:
    cache
    move r13, r15
        stw (fb_ptr)
        inc fb_ptr
        loop
        inc fb_ptr
    nop

    ; Enable 4bpp transparency (color 0 transparent)
    iwt r0, #$08
    cmode

    ; Dispatch Hybrid 3D Mesh engine (GSU_SCENE_MODE != 0) vs MapGrid (== 0)
    lm tmp, (GSU_SCENE_MODE)
    moves tmp, tmp
    bne @mesh_mode
    nop

    ; --- MapGrid Mode (gsu_iso) ---
    lm tmp, (GSU_INIT_FLAG)
    moves tmp, tmp
    bne @iso_scene_ready
    nop
    call gsu_iso_import_bank71
@iso_scene_ready:
    iwt r1, #GSU_SCENE_DESC
    move r2, frame_half
    call gsu_iso_render_from_descriptor r1, r2
    bra @pass_finish
    nop

@mesh_mode:
    ; --- Hybrid 3D Mesh Mode (gsu_mesh + companion sfx_mesh_grid) ---
    lm tmp, (GSU_INIT_FLAG)
    moves tmp, tmp
    bne @mesh_scene_ready
    nop
    call gsu_mesh_import_bank71
@mesh_scene_ready:
    iwt r1, #GSU_SCENE_DESC
    move r2, frame_half
    call gsu_mesh_render_from_descriptor r1, r2

@pass_finish:
    ; Flush dual 8-pixel plot caches + 8-NOP RAM settling before stop
    rpix
    rpix
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    stop
    nop
    nop
    nop
